# Helpers used below (defined in dot_functions):
#   alias:safe      sets the alias unless a real command owns that name, and
#                   warns whenever it skips one (default)
#   alias:fallback  the same, minus the warning (used for polyfills)
#   plain `alias`   deliberate shadows (cat→bat, top→btop, etc.) and syntax
#                   the helpers cannot wrap (`alias -s`, `alias -- -=`)

# --------------------------- Plugin Corrections ----------------------------- #
# The Oh My Zsh bundle (~/.plugins) loads immediately before this file. Anything
# further down overrides it simply by defining the same name again. This section
# covers the cases that need a removal instead, so it has to run before the rest
# of the file rather than after it.
#
# `alias:shadows` prints every alias currently sitting on a real binary. Run it
# after adding a plugin to see whether this list needs another entry.

# common-aliases makes rm, cp and mv interactive. rm is the urgent one: the
# alias has to go before the trash-put wrapper below can be defined at all,
# because zsh refuses to declare a function whose name is an existing alias and
# fails the entire file with a parse error at that line.
unalias rm cp mv 2>/dev/null

# Drop common-aliases' suffix aliases whose viewer is not installed here and
# keep the ones that work, so `.tar` still lists an archive and `.c` still opens
# an editor. The suffix aliases this file sets are defined at the bottom, long
# after this pass, so only plugin entries are considered.
alias:prune-suffix

# Global aliases expand anywhere on the line, so the two whose pager is missing
# would fire on any bare M or P. The names have to be quoted, because unquoted
# they are global aliases themselves and expand before unalias ever sees them,
# leaving it with no arguments. zsh has no `unalias -g` either.
unalias "M" "P" 2>/dev/null

# Give these names back to their binaries. Every one is a tool installed on
# purpose, so the plugin alias loses:
#   gcp grm gpr god  coreutils cp, rm, pr and od
#   cs               the Coursier launcher, which .zshrc deliberately appends to
#                    PATH so it never shadows another binary
#   ng ni na         the Angular CLI and @antfu/ni, both pinned in
#                    mise/config.toml. The nestjs plugin claims all three, and
#                    ng also has a hand-written completion in .completions
# Two shadows stay on purpose: `cu` (composer update over the legacy serial-line
# tool) and `asr` (aws over Apple Software Restore).
unalias gcp grm gpr god cs ng ni na 2>/dev/null

# The emacs plugin points `emacs` at its own emacsclient wrapper. Keep the
# Homebrew binary. Every other alias the plugin sets stays.
unalias emacs 2>/dev/null

# -------------------------- Filesystem & Navigation ------------------------- #

# Number the directory stack for `cd -<n>` (deliberate shadow of the builtin)
alias dirs='dirs -v'

# Climb directories quickly (~ for home, `-` for previous)
alias:safe ..="cd .."
alias:safe ...="cd ../.."
alias:safe ....="cd ../../.."
alias:safe .....="cd ../../../.."
alias:safe ~="cd ~"
alias -- -="cd -"

# Prefer lsd if available, otherwise colorize ls (deliberate shadow of /bin/ls)
if cmd:exists lsd; then
  alias ls='lsd'
else
  alias ls='command ls -G'
  export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
fi

# l (long format) and la (long format, all but . and ..) come from the
# common-aliases plugin, which sets the same pair plus -h for readable sizes.
# Both still chain through the ls alias above, so lsd renders them.

# List only directories. Named lsdir to avoid colliding with lsd, the Homebrew
# binary that `ls` aliases to when it is installed.
alias:safe lsdir="command ls -lF | grep --color=never '^d'"

# Print each PATH entry on a separate line
alias:safe path='echo -e ${PATH//:/\\n}'

# ------------------------------- System Tools ------------------------------- #

# Deliberate shadows: prefer modern replacements when installed
cmd:exists python3 && alias python=python3
cmd:exists btop    && alias top='btop'
cmd:exists bat     && alias cat='bat --paging=never'

# Safer rm, moving files to the Trash when trash-put is installed. Names
# matching TRASH_SKIP (set in .exports) are deleted outright instead, so bulky
# throwaway directories never pile up in ~/.local/share/Trash.
if cmd:exists trash-put; then
  rm() {
    local flags=() delete=() trash=()
    for arg in "$@"; do
      case "$arg" in
        -*) flags+=("$arg") ;;
        *)
          if [[ -n "${TRASH_SKIP:-}" && "${arg##*/}" == @(${TRASH_SKIP}) ]]; then
            delete+=("$arg")
          else
            trash+=("$arg")
          fi
          ;;
      esac
    done
    (( ${#delete[@]} )) && command rm "${flags[@]}" "${delete[@]}"
    (( ${#trash[@]} ))  && trash-put "${flags[@]}" "${trash[@]}"
  }
fi

# Deliberate shadows: ssh adds each key to the agent on first use, and bash
# carries a PERMIT_BASH marker that nothing in this repo reads
alias ssh='ssh -o AddKeysToAgent=yes'
alias bash='PERMIT_BASH=true bash'

# Restart the shell in place, as a login shell
# shellcheck disable=SC2139
alias:safe reload="exec ${SHELL} -l"

# --------------------------------- AI Tools --------------------------------- #

# Deliberate shadows: wrap CLIs with permissive defaults
alias claude="claude --dangerously-skip-permissions --remote-control"
alias codex="codex --yolo"
alias copilot="copilot --allow-all"
alias:safe kiro="kiro-cli"

# Short 3-letter aliases (chain to the wrappers above, inheriting their flags)
alias:safe cld="claude"
alias:safe cdx="codex"
alias:safe cpl="copilot"
alias:safe gmi="gemini"
alias:safe kro="kiro"

# ------------------------------- macOS Tweaks ------------------------------- #

# Sleep the display to lock. Relies on "Require password after sleep" being set.
alias:safe afk='pmset displaysleepnow'

# Show/hide hidden files in Finder
alias:safe show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias:safe hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# Hide/show all desktop icons (useful when presenting)
alias:safe hidedesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
alias:safe showdesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"

# Flush Directory Service cache
alias:safe flush="dscacheutil -flushcache && killall -HUP mDNSResponder"

# Clean up LaunchServices to remove duplicates in the "Open With" menu
alias:safe lscleanup="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user && killall Finder"

# Disable / enable Spotlight
alias:safe spotoff="sudo mdutil -a -i off"
alias:safe spoton="sudo mdutil -a -i on"

# Empty every Trash (mounted volumes, macOS, freedesktop), delete the Apple
# System Log archives, and clear the LaunchServices quarantine event database
alias:safe emptytrash="sudo /bin/rm -rfv /Volumes/*/.Trashes; sudo /bin/rm -rfv ~/.Trash; /bin/rm -rfv ~/.local/share/Trash/files/* ~/.local/share/Trash/info/*; sudo /bin/rm -rfv /private/var/log/asl/*.asl; sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* 'delete from LSQuarantineEvent'"

# Recursively delete `.DS_Store` files
alias:safe cleanup="find . -type f -name '*.DS_Store' -ls -delete"

# Volume controls
alias:safe stfu="osascript -e 'set volume output muted true'"
alias:safe pumpitup="osascript -e 'set volume output volume 100'"

# -------------------------------- Networking -------------------------------- #

# Local IP addresses
alias:safe ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias:safe localip="ipconfig getifaddr en0"
alias:safe ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Public IP via ifconfig.me
alias:safe myip='curl -s ifconfig.me'

# Show active network interfaces
alias:safe ifactive="ifconfig | awk '/^[^ ]/{iface=\$1} /status: active/{print iface}'"

# Show listening ports
alias:safe ports='lsof -i -P -n | grep LISTEN'

# ------------------------------- Kubernetes --------------------------------- #

cmd:exists kubectl && alias:safe k='kubectl'
cmd:exists kubens  && alias:safe kn='kubens'
cmd:exists kubectx && alias:safe kx='kubectx'

# --------------------------------- Utilities -------------------------------- #

# Colored `grep` output comes from the common-aliases plugin, which self-shadows
# /usr/bin/grep with `grep --color`.

# Trailing space makes zsh expand the next word as an alias too, so aliases can
# be sudo'ed (deliberate self-shadow)
alias sudo='sudo '

# Update macOS, Homebrew, mise-managed tools, and Ruby gems (the mise and gem
# steps are guarded by cmd:exists). mise runs with -C "$HOME" so it upgrades the
# global toolchain, not whichever project the shell happens to sit in. Every
# other step here is system-wide too.
alias:safe update='sudo softwareupdate -i -a; brew update && brew upgrade && brew cleanup; cmd:exists mise && mise -C "$HOME" upgrade; cmd:exists gem && sudo gem update --system && sudo gem update && sudo gem cleanup'

# macOS ships no `hd`, `md5sum`, or `sha1sum`. alias:fallback stands in for them
# quietly, and steps aside on systems that have the real binaries.
alias:fallback hd="hexdump -C"
alias:fallback md5sum="md5"
alias:fallback sha1sum="shasum"

# JavaScriptCore REPL
if [[ -e "/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Resources/jsc" ]]; then
  alias:safe jsc="/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Resources/jsc"
fi

# Disk usage of current dir entries (sorted) and free space
alias:safe dud='du -sh * | sort -h'
alias:safe duf='df -h'

# Make a file executable
alias:safe chx='chmod +x'

# Trim new lines and copy to clipboard
alias:safe c="tr -d '\n' | pbcopy"

# URL-encode strings
alias:safe urlencode='python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))"'

# PlistBuddy
alias:safe plistbuddy="/usr/libexec/PlistBuddy"

# Run a command once per line of input. To list every directory holding a
# given file: find . -name .gitattributes | map dirname
alias:safe map="xargs -n1"

# Quick HTTP server in current dir
alias:safe serve='python3 -m http.server'

# Terminal weather and cheat sheets (e.g. `cheat tar`)
alias:safe weather='curl wttr.in'
alias:safe cheat='curl cheat.sh/'

# QR code in terminal (usage: echo "url" | qr)
cmd:exists qrencode && alias:safe qr='qrencode -t ANSIUTF8'

# Generate a strong random password and a lowercase UUID
alias:safe genpw='openssl rand -base64 16'
alias:safe uuid='uuidgen | tr A-Z a-z'

# Top 20 most-used commands from history
alias:safe myhist='history | awk "{print \$2}" | sort | uniq -c | sort -rn | head -20'

# --------------------------- Time / Productivity ---------------------------- #

# Stopwatch (press enter to stop)
alias:safe timer='time read -p "Press enter to stop"'

# Get week number
alias:safe week='date +%V'

# Current date+time, today's date, Unix epoch seconds
alias:safe now='date +"%Y-%m-%d %H:%M:%S"'
alias:safe today='date +"%Y-%m-%d"'
alias:safe epoch='date +%s'

# ------------------------------ JSON / Data --------------------------------- #

cmd:exists jq && alias:safe jqp='jq .'
alias:safe json='python3 -m json.tool'

# ------------------------------ Docker -------------------------------------- #

cmd:exists docker && {
  alias:safe d='docker'
  alias dc='docker compose'         # deliberate shadow of /usr/bin/dc (RPN calculator)
  alias:safe dps='docker ps'
  alias:safe dpsa='docker ps -a'
  alias:safe dimg='docker images'
  alias:safe dprune='docker system prune -af'
}

