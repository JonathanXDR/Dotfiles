alias -s go='$EDITOR'
alias -s md='$EDITOR'
alias -s yaml='$EDITOR'
alias -s yml='$EDITOR'
alias -s js='$EDITOR'
alias -s ts='$EDITOR'
alias -s json='$EDITOR'
