# Completions, autocompletion, and the ZLE widgets around them. Order matters
# here, so read the notes before moving a block.

# Homebrew prefix (HOMEBREW_PREFIX is already set by `brew shellenv` in .zshrc)
local brew_share=""
local has_zsh_autocomplete=0
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  brew_share="${HOMEBREW_PREFIX}/share"

  # Let zsh-autocomplete own its fpath entries. Sourcing it below re-adds
  # Completions and z-async, so drop any copies inherited from a parent shell,
  # which may point at a version that no longer exists.
  typeset -gU FPATH fpath
  local -a clean_fpath
  clean_fpath=( ${fpath:#*/zsh-autocomplete/Completions} )
  fpath=( "${brew_share}/zsh-completions" ${clean_fpath:#*/zsh-autocomplete/z-async} )

  if [[ -f "${brew_share}/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
    # Kiro CLI compatibility. Keep zsh-autocomplete's manual widgets, but
    # disable the async redraw loop that wipes Kiro's figterm inline
    # suggestions.
    zstyle ':autocomplete:async' enabled no
    source "${brew_share}/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
    has_zsh_autocomplete=1
  fi
fi

# zsh-autocomplete runs compinit itself, so only do it when the plugin is
# missing. -C skips the security scan while the dump is under 24 hours old.
if (( ! has_zsh_autocomplete )); then
  autoload -Uz compinit
  if [[ -n ~/.zcompdump(N.mh-24) ]]; then
    compinit -C
  else
    compinit
  fi
fi

# Bun completions
[[ -s "${HOME}/.bun/_bun" ]] && source "${HOME}/.bun/_bun"

# Angular CLI autocompletion (zsh native, no caching needed)
if cmd:exists ng; then
  _ng_completion() {
    local -a completions
    completions=($(ng --get-yargs-completions "${words[@]}" 2>/dev/null))
    compadd -a completions
  }
  compdef _ng_completion ng
fi

# Optional plugins, each guarded in case it is not installed
if [[ -n "$brew_share" ]]; then
  [[ -f "${brew_share}/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] \
    && source "${brew_share}/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# Kiro CLI owns Tab, so Shift+Tab is the manual way into zsh-autocomplete's
# menu. Clear the ghost text first, or it gets committed into the buffer
# alongside the completion that was picked.
if (( $+widgets[menu-select] )); then
  _zsh_autocomplete_fallback() {
    unset POSTDISPLAY
    zle menu-select
  }

  zle -N _zsh_autocomplete_fallback
  bindkey '\e[Z' _zsh_autocomplete_fallback
fi

# Syntax highlighting and history substring search wrap existing ZLE widgets,
# so they must be sourced after every other widget above is defined
if [[ -n "$brew_share" ]]; then
  [[ -f "${brew_share}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] \
    && source "${brew_share}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

  [[ -f "${brew_share}/zsh-history-substring-search/zsh-history-substring-search.zsh" ]] \
    && source "${brew_share}/zsh-history-substring-search/zsh-history-substring-search.zsh"
fi
