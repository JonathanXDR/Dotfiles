#!/bin/bash
# proxy-watchd: Probes the proxy and updates the launchctl proxy variables.
# Run by the local.proxy-watchd LaunchAgent whenever the network changes.
# Managed by chezmoi (do not edit directly).
set -euo pipefail

# Proxy configuration (baked in by chezmoi at apply time)
PROXY_PROTOCOL="{{ .proxy_protocol }}"
PROXY_HOST="{{ .proxy_host }}"
PROXY_PORT="{{ .proxy_port }}"
NO_PROXY="{{ .no_proxy }}"
NPM_REGISTRY_PROXIED="{{ .npm_swisscom_registry_proxied }}"
NPM_REGISTRY_DIRECT="{{ .npm_swisscom_registry_direct }}"

STATE_FILE="${HOME}/.cache/proxy-state"

mkdir -p "${HOME}/.cache"

# Probe proxy reachability
if nc -z -w 3 "${PROXY_HOST}" "${PROXY_PORT}" &>/dev/null; then
  state="on"
else
  state="off"
fi

# The state file survives a reboot but the launchd session environment does not,
# so the launchctl calls below run every time and only the logging is gated on
# an actual flip.
current="$(cat "${STATE_FILE}" 2>/dev/null || true)"
if [[ "${state}" != "${current}" ]]; then
  printf '%s\n' "${state}" > "${STATE_FILE}"
  logger "proxy-watchd: ${current:-<none>} -> ${state}"
fi

# GUI apps never read the shell config, so publish the proxy through launchctl
if [[ "${state}" == "on" ]]; then
  addr="${PROXY_PROTOCOL}://${PROXY_HOST}:${PROXY_PORT}"
  launchctl setenv HTTP_PROXY "${addr}"
  launchctl setenv HTTPS_PROXY "${addr}"
  launchctl setenv ALL_PROXY "${addr}"
  launchctl setenv NO_PROXY "${NO_PROXY}"
  launchctl setenv NPM_SWISSCOM_REGISTRY "${NPM_REGISTRY_PROXIED}"
else
  launchctl unsetenv HTTP_PROXY
  launchctl unsetenv HTTPS_PROXY
  launchctl unsetenv ALL_PROXY
  launchctl unsetenv NO_PROXY
  # Set rather than unset, because .npmrc has no fallback for a missing value
  launchctl setenv NPM_SWISSCOM_REGISTRY "${NPM_REGISTRY_DIRECT}"
fi
