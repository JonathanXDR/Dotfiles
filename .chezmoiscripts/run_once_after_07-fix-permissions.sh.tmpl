#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# Drop group-write from the Homebrew zsh completion directories. That bit is
# the usual cause of compaudit's insecure directory warnings at shell startup.

_ensure_brew

if ! _cmd_exists brew; then
  _log warning "Skipped zsh completion permissions (brew not installed)"
  exit 0
fi

BREW_PREFIX="$(brew --prefix)"
failed=0
for dir in "${BREW_PREFIX}/share/zsh-completions" "${BREW_PREFIX}/share/zsh/site-functions"; do
  if [[ -d "$dir" ]]; then
    # chmod fails on a directory this user does not own. That must not abort the
    # apply, so the status is carried to the closing message instead.
    chmod g-w "$dir" || failed=1
  fi
done

if (( failed )); then
  _log warning "Failed to drop group-write from the zsh completion directories"
else
  _log success "Verified zsh completion directory permissions"
fi
