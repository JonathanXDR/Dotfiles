#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# The chezmoi destination for this repo is $HOME, so /etc/hosts cannot be a
# managed file. chezmoi renders ~/.config/hosts like any other target and this
# script installs a root-owned copy of it over /etc/hosts.
#
# A copy, not a symlink. Pointing /etc/hosts at a file in $HOME handed every
# process running as this user the ability to rewrite system name resolution
# with no sudo at all, which is a boundary the system expects to be root-only.
# An npm postinstall or any CLI could redirect any hostname silently.
#
# This runs on every apply rather than behind a content hash, because the state
# it depends on is /etc/hosts itself. A macOS upgrade, Docker Desktop, or a VPN
# client can replace it, and only a check on every apply notices and repairs
# that.

HOSTS_SRC="{{ .chezmoi.homeDir }}/.config/hosts"

if [[ ! -f "$HOSTS_SRC" ]]; then
  _log error "Failed to find rendered hosts file ($HOSTS_SRC)"
  _log info "Run 'chezmoi apply ~/.config/hosts' to render it, then apply again"
  exit 1
fi

# Back up only the first real file seen. A symlink is the previous design's
# work, and a regular file written later by an installer must not become the
# backup either, so the marker file is what makes this once-only.
if [[ -f /etc/hosts && ! -L /etc/hosts && ! -e /etc/hosts.chezmoi-backup ]]; then
  _log info "Backing up the current /etc/hosts…"
  sudo cp /etc/hosts /etc/hosts.chezmoi-backup
  _log success "Backed up the previous /etc/hosts (/etc/hosts.chezmoi-backup)"
fi

# Silent in the steady state, so the every-apply check stays invisible. `cmp`
# follows a symlink and would call the old layout identical, so test for one
# separately. Write beside the target and rename, because renaming over a
# symlink replaces the link itself rather than writing through it, and never
# leaves /etc/hosts missing on a failed write.
if [[ -L /etc/hosts ]] || ! cmp -s "$HOSTS_SRC" /etc/hosts; then
  _log info "Installing /etc/hosts from ${HOSTS_SRC} (requires sudo)…"
  sudo install -m 0644 -o root -g wheel "$HOSTS_SRC" /etc/hosts.chezmoi-new
  sudo mv -f /etc/hosts.chezmoi-new /etc/hosts
  _log success "Installed /etc/hosts from ${HOSTS_SRC}"
fi
