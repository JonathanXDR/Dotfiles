#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# Unlock the dotfiles keychain once per `chezmoi apply` so later template
# renders, which call `security find-generic-password`, read managed secrets
# without prompting. Custom keychains are not auto-managed by securityd, so
# without this every render would trigger its own unlock prompt.
#
# The script also re-applies the lock policy on every run, so a machine with a
# misconfigured keychain heals itself. Policy: lock on system sleep, no idle
# timeout (`-l` only).

KEYCHAIN_NAME={{ .keychain_name | quote }}
KEYCHAIN="${HOME}/Library/Keychains/${KEYCHAIN_NAME}.keychain-db"
KEYCHAIN_PASSWORD={{ if hasKey . "keychain_password" }}{{ .keychain_password | quote }}{{ else }}""{{ end }}

# Nothing to unlock on a first apply, since run_once_before_02 creates the
# keychain.
[[ -f "$KEYCHAIN" ]] || exit 0

# Unlock first. `security set-keychain-settings` needs an unlocked keychain and
# blocks on the macOS GUI unlock dialog otherwise, which would hang the whole
# apply before any template renders. The keychain is locked in exactly the two
# cases this script exists for: a configured master password, and the `-l`
# policy this line installs, which locks on system sleep.
# Passing the password with `-p` puts it in the process table, which any local
# account can read, and security's own usage text calls the flag insecure.
# Interactive mode takes the same command on stdin instead and still exits
# non-zero on a wrong password. The two substitutions escape backslashes and
# then double quotes for the interactive parser.
escaped="${KEYCHAIN_PASSWORD//\\/\\\\}"
printf 'unlock-keychain -p "%s" "%s"\n' "${escaped//\"/\\\"}" "$KEYCHAIN" | security -i
security set-keychain-settings -l "$KEYCHAIN"
