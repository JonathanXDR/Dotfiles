#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# Plist content hash (triggers a re-run when the plist changes):
# {{ include "Library/LaunchAgents/local.proxy-watchd.plist.tmpl" | sha256sum }}

PLIST_LABEL="local.proxy-watchd"
PLIST_PATH="${HOME}/Library/LaunchAgents/${PLIST_LABEL}.plist"

{{ if eq .machine_type "work" -}}
if [[ ! -f "${PLIST_PATH}" ]]; then
  _log warning "Skipped proxy LaunchAgent bootstrap (no plist at ${PLIST_PATH})"
  exit 0
fi

# bootout returns before launchd has finished tearing the service down, and a
# bootstrap that lands in that window fails with "Bootstrap failed: 5:
# Input/output error", which would abort the rest of the apply. Waiting for the
# service to disappear closes that window.
launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
for _ in {1..50}; do
  launchctl print "gui/$(id -u)/${PLIST_LABEL}" &>/dev/null || break
  sleep 0.1
done
launchctl bootstrap "gui/$(id -u)" "${PLIST_PATH}"

_log success "Bootstrapped proxy LaunchAgent (${PLIST_LABEL})"
{{ else -}}
# Not a work machine. bootout only unloads for the current session, and launchd
# bootstraps every plist in ~/Library/LaunchAgents again at the next login, so
# the plist itself has to go.
launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
rm -f "${PLIST_PATH}"
{{ end -}}
