#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

{{ if eq .machine_type "work" -}}
# Rendered plist hash, so a new keychain credential also restarts Alpaca:
# {{ includeTemplate "private_Library/LaunchAgents/private_local.alpaca.plist.tmpl" . | sha256sum }}
#
# Alpaca keg, so an upgrade restarts the agent and a run skipped for a missing
# binary retries:
# alpaca: {{ output "sh" "-c" "readlink /opt/homebrew/opt/alpaca 2>/dev/null || echo missing" | trim }}

{{ end -}}
PLIST_LABEL="local.alpaca"
PLIST_PATH="${HOME}/Library/LaunchAgents/${PLIST_LABEL}.plist"
PID_FILE="${HOME}/.cache/alpaca.pid"

# Leftovers of the proxy-watchd agent. bootout only unloads it for this
# session, so its files have to go too.
launchctl bootout "gui/$(id -u)/local.proxy-watchd" 2>/dev/null || true
rm -f "${HOME}/Library/LaunchAgents/local.proxy-watchd.plist" \
      "${HOME}/.local/bin/proxy-watchd" \
      "${HOME}/.cache/proxy-state" \
      "${HOME}/Library/Logs/proxy-watchd.log"

# launchctl variables last until logout. Clear proxy-watchd's and the agent's
# own, so none outlives its proxy. The agent publishes its set again when it
# starts.
for name in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY \
            no_proxy NO_PROXY NPM_SWISSCOM_REGISTRY; do
  launchctl unsetenv "$name" 2>/dev/null || true
done

{{ if eq .machine_type "work" -}}
if [[ ! -x /opt/homebrew/opt/alpaca/bin/alpaca ]]; then
  _log warning "Skipped Alpaca LaunchAgent bootstrap (alpaca not installed)"
  exit 0
fi

# A malformed plist makes bootstrap fail, which would abort the rest of the
# apply.
if ! plutil -lint -s "${PLIST_PATH}"; then
  _log warning "Skipped Alpaca LaunchAgent bootstrap (invalid plist at ${PLIST_PATH})"
  exit 0
fi

# bootout returns before launchd has finished tearing the service down, and a
# bootstrap that lands in that window fails with "Bootstrap failed: 5:
# Input/output error", which would abort the rest of the apply. Waiting for the
# service to disappear closes that window. The PID file goes with the old
# process, so no shell trusts a PID that could be reused.
launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
for _ in {1..50}; do
  launchctl print "gui/$(id -u)/${PLIST_LABEL}" &>/dev/null || break
  sleep 0.1
done
rm -f "${PID_FILE}"
launchctl bootstrap "gui/$(id -u)" "${PLIST_PATH}"

_log success "Bootstrapped Alpaca LaunchAgent (${PLIST_LABEL})"
{{ else -}}
# Not a work machine. bootout only unloads for the current session, and launchd
# bootstraps every plist in ~/Library/LaunchAgents again at the next login, so
# the plist itself has to go.
launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
rm -f "${PLIST_PATH}" "${PID_FILE}"
{{ end -}}
