#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}
{{- if not .agent_skills_store }}{{ fail "agent_skills_store must not be empty" }}{{ end }}

# Install the Agent Skills that .chezmoidata/skills.toml declares:
#
#   1. Keep one shallow, blobless, sparse clone per source repository under
#      agent_skills_store. A missing one is cloned, and one not fetched for
#      agent_skills_refresh_days is updated, up to eight at a time. Each is
#      then narrowed to the skill folders the inventory declares from it, and
#      each of those skills is linked into agent_skills_home.
#   2. Clone or pull the private repositories, which live in agent_skills_home
#      as working trees the user edits.
#   3. Download the licensed skills, with a token read from the keychain.
#   4. Link every skill into the agents that do not read agent_skills_home
#      themselves, which today means Claude Code alone.
#   5. Remove the skills the inventory no longer declares and the clones no
#      skill uses.
#
# This script, not chezmoi externals, owns the clones: chezmoi stops a whole
# apply at the first external that fails, while a failure here is a warning
# and every other skill still installs. It runs on every apply. With nothing
# due, it makes no network call except the licensed downloads, and the checks
# per skill are bash tests rather than subprocesses. Written for /bin/bash 3.2,
# the version macOS ships, so there are no associative arrays. Membership
# tests match against a newline-separated list instead.
#
# Set AGENT_SKILLS_REFRESH=1 to update every clone now instead of when due.

SKILLS_HOME={{ printf "%s/%s" .chezmoi.homeDir .agent_skills_home | shellQuote }}
STORE={{ printf "%s/%s" .chezmoi.homeDir .agent_skills_store | shellQuote }}
REFRESH_DAYS={{ .agent_skills_refresh_days | toString | shellQuote }}
KEYCHAIN={{ printf "%s/Library/Keychains/%s.keychain-db" .chezmoi.homeDir .keychain_name | shellQuote }}
KEYCHAIN_FLAG={{ includeTemplate "keychain-flag" .keychain_lookup_field | shellQuote }}

# What the last run installed, so this one can tell a skill that was dropped
# from the inventory apart from a skill that was never managed here. Without
# that distinction the only safe prune is no prune, and a hand-installed skill
# is exactly what must survive. Losing the file costs one skipped prune, which
# is why it lives under the state directory rather than in the repo.
LEDGER={{ printf "%s/.local/state/agent-skills/managed" .chezmoi.homeDir | shellQuote }}

# Marks when a clone was last fetched. git ignores unknown files in .git.
STAMP="agent-skills-fetched"

# Skipped unless the agent's own directory already exists, so an agent this
# machine does not have gets no empty skills directory invented for it.
link_dirs=(
{{- range .agent_skills_link_dirs }}
  {{ printf "%s/%s" $.chezmoi.homeDir . | shellQuote }}
{{- end }}
)

# ----------------------------------- Data ----------------------------------- #

# One call per skill, clone and licensed download, rendered from the inventory.
names=() origins=() targets=()
_skill() { names+=("$1") origins+=("$2") targets+=("${3:-}"); }
clone_dirs=() clone_urls=() clone_refs=() clone_patterns=()
_clone() {
  local p
  clone_dirs+=("$1") clone_urls+=("$2") clone_refs+=("$3")
  shift 3
  printf -v p '%s\n' "$@"
  clone_patterns+=("$p")
}
tree_names=() tree_urls=()
_tree() { tree_names+=("$1") tree_urls+=("$2"); }
licensed=()
_licensed() { licensed+=("$1" "$2" "$3" "$4" "$5"); }

{{  $store := printf "%s/%s" .chezmoi.homeDir .agent_skills_store -}}
{{- $clones := dict -}}
{{- range $name, $skill := .agent_skills -}}
{{-   $path := get $skill "path" -}}
{{-   if hasKey $skill "repo" -}}
{{-     $ref := get $skill "ref" -}}
{{-     $key := lower $skill.repo -}}
{{-     if $ref }}{{ $key = printf "%s@%s" $key $ref }}{{ end -}}
{{-     $pattern := "/*" -}}
{{-     if $path }}{{ $pattern = printf "/%s/" $path }}{{ end -}}
{{-     $clone := get $clones $key | default (dict "repo" $skill.repo "ref" $ref "patterns" list) -}}
{{-     $_ := set $clone "patterns" (append $clone.patterns $pattern) -}}
{{-     $_ := set $clones $key $clone -}}
_skill {{ $name | shellQuote }} {{ printf "%s (%s)" $skill.repo (default "repository root" $path) | shellQuote }} {{ trimSuffix "/" (printf "%s/%s/%s" $store $key $path) | shellQuote }}
{{    else if hasKey $skill "git" -}}
_skill {{ $name | shellQuote }} {{ $skill.git | shellQuote }}
_tree {{ $name | shellQuote }} {{ $skill.git | shellQuote }}
{{    else if hasKey $skill "token" -}}
_skill {{ $name | shellQuote }} {{ $skill.url | shellQuote }}
_licensed {{ $name | shellQuote }} {{ $skill.url | shellQuote }} {{ $skill.header | shellQuote }} {{ $skill.token | shellQuote }} {{ $skill.account | shellQuote }}
{{    else -}}
_skill {{ $name | shellQuote }} {{ printf "dot_agents/skills/%s in this repository" $name | shellQuote }}
{{    end -}}
{{- end -}}
{{- range $key, $clone := $clones -}}
{{-   $patterns := uniq (sortAlpha $clone.patterns) -}}
{{-   if has "/*" $patterns }}{{ $patterns = list "/*" }}{{ end -}}
_clone {{ printf "%s/%s" $store $key | shellQuote }} {{ printf "https://github.com/%s.git" $clone.repo | shellQuote }} {{ $clone.ref | shellQuote }}{{ range $patterns }} {{ . | shellQuote }}{{ end }}
{{ end }}
# Built through guards because expanding an empty array under `set -u` is an
# error in bash 3.2 rather than nothing.
declared_list=""
((${#names[@]})) && printf -v declared_list '%s\n' "${names[@]}"
checkout_list=""
((${#clone_dirs[@]})) && printf -v checkout_list '%s\n' "${clone_dirs[@]}"
managed_list=""
[[ -r "$LEDGER" ]] && IFS= read -r -d '' managed_list <"$LEDGER" || true
foreign_list=""

_listed() { [[ $'\n'"$2" == *$'\n'"$1"$'\n'* ]]; }

WORK_DIR="$(mktemp -d)"
trap 'command rm -rf "$WORK_DIR"' EXIT
mkdir -p "$SKILLS_HOME"

# ------------------------------- Clone, update ------------------------------ #

# A clone is due when it is missing or was last fetched before this reference
# time. Comparing against one reference file keeps the check a bash test.
touch -t "$(date -v-"${REFRESH_DAYS}"d +%Y%m%d%H%M.%S)" "${WORK_DIR}/due"
_due() { [[ -n "${AGENT_SKILLS_REFRESH:-}" || ! "$1/.git/${STAMP}" -nt "${WORK_DIR}/due" ]]; }

_update_clone() {
  local dir="$1" url="$2" ref="$3" err
  if [[ ! -d "${dir}/.git" ]]; then
    local -a args=(clone --quiet --depth 1 --filter=blob:none --sparse)
    [[ -z "$ref" ]] || args+=(--branch "$ref")
    command rm -rf "$dir"
    if ! err="$(git "${args[@]}" "$url" "$dir" 2>&1)"; then
      command rm -rf "$dir"
      _log warning "Failed to clone ${dir#"${STORE}/"} (${err##*$'\n'})"
      return 0
    fi
  # The clone is a mirror nobody edits, so a reset rather than a merge keeps it
  # at depth 1 and survives a force-push upstream.
  elif ! err="$(git -C "$dir" fetch --quiet --depth 1 origin "${ref:-HEAD}" 2>&1 \
    && git -C "$dir" reset --quiet --hard FETCH_HEAD 2>&1)"; then
    _log warning "Failed to update ${dir#"${STORE}/"} (${err##*$'\n'}, keeping the current files)"
    return 0
  fi
  touch "${dir}/.git/${STAMP}"
}

# A private repository is a working tree the user edits and pushes from, so it
# is a full clone and only ever fast-forwarded. Anything else leaves it alone.
_update_tree() {
  local dir="${SKILLS_HOME}/$1" url="$2" err
  if [[ ! -d "${dir}/.git" ]]; then
    if [[ -e "$dir" ]]; then
      _log warning "Skipped cloning $1 (${dir} already exists)"
      return 0
    fi
    if ! err="$(git clone --quiet "$url" "$dir" 2>&1)"; then
      _log warning "Failed to clone $1 (${err##*$'\n'})"
      return 0
    fi
  elif ! err="$(git -C "$dir" pull --quiet --ff-only 2>&1)"; then
    _log warning "Failed to pull $1 (${err##*$'\n'}, left untouched)"
    return 0
  fi
  touch "${dir}/.git/${STAMP}"
}

# Run in the background, eight at a time. bash 3.2 has no `wait -n`, so each
# batch waits for its slowest job, which is fine for a weekly refresh. The
# explicit subshell is load-bearing: bash 3.2 runs a function started with a
# bare `&` so that its first `command <utility>` replaces the whole job, and
# nothing after that line ever runs.
running=0
_spawn() {
  ("$@") &
  running=$((running + 1))
  ((running < 8)) || { wait; running=0; }
}

for ((i = 0; i < ${#clone_dirs[@]}; i++)); do
  _due "${clone_dirs[i]}" && _spawn _update_clone "${clone_dirs[i]}" "${clone_urls[i]}" "${clone_refs[i]}"
done
for ((i = 0; i < ${#tree_names[@]}; i++)); do
  _due "${SKILLS_HOME}/${tree_names[i]}" && _spawn _update_tree "${tree_names[i]}" "${tree_urls[i]}"
done
wait

# ----------------------------- Narrow and link ------------------------------ #

# Narrow a clone to its skill folders, but only when they changed, so an
# unchanged clone costs a file read rather than a git call.
_narrow() {
  local dir="$1" want="$2" current="" err
  [[ -d "${dir}/.git" ]] || return 0
  [[ -r "${dir}/.git/info/sparse-checkout" ]] \
    && IFS= read -r -d '' current <"${dir}/.git/info/sparse-checkout" || true
  [[ "$current" == "$want" ]] && return 0

  if err="$(printf '%s' "$want" | git -C "$dir" sparse-checkout set --no-cone --stdin 2>&1)"; then
    _log success "Checked out the skill folders in ${dir#"${STORE}/"}"
  else
    _log warning "Failed to narrow ${dir#"${STORE}/"} to its skills (${err##*$'\n'})"
  fi
}

for ((i = 0; i < ${#clone_dirs[@]}; i++)); do
  _narrow "${clone_dirs[i]}" "${clone_patterns[i]}"
done

# Point agent_skills_home/<name> at its folder inside a clone. A real
# directory in the way is replaced only when this script installed it and
# only once the clone holds the skill, so a failed clone keeps the working
# copy rather than leaving a dead link. A git working tree is never replaced.
linked=0
_link_skill() {
  local name="$1" target="$2" link="${SKILLS_HOME}/$1"
  [[ -L "$link" && "$link" -ef "$target" ]] && return 0
  [[ -L "$link" && "$(readlink "$link")" == "$target" ]] && return 0

  if [[ -e "$link" && ! -L "$link" ]]; then
    if [[ -d "${link}/.git" ]] || ! _listed "$name" "$managed_list"; then
      foreign_list+="${name}"$'\n'
      _log warning "Skipped linking ${name} into ${SKILLS_HOME} (a real directory is already there)"
      return 0
    fi
    [[ -f "${target}/SKILL.md" ]] || return 0
    command rm -rf "$link"
  fi
  ln -sfn "$target" "$link"
  linked=$((linked + 1))
}

for ((i = 0; i < ${#names[@]}; i++)); do
  [[ -z "${targets[i]}" ]] || _link_skill "${names[i]}" "${targets[i]}"
done
((linked == 0)) || _log success "Linked ${linked} skill(s) into ${SKILLS_HOME}"

# ------------------------------ Licensed skills ----------------------------- #

# Replace the skill only when the download differs from what is already there,
# so an unchanged skill keeps its mtimes and this script stays quiet. The CDN
# offers no conditional request, so each licensed skill costs one download per
# apply, which is also how a failed one retries.
_install_licensed() {
  local name="$1" url="$2" header="$3" id="$4" account="$5"
  local dest="${SKILLS_HOME}/${name}"
  local unpacked="${WORK_DIR}/${name}"
  local archive="${WORK_DIR}/${name}.tar.gz"
  local token

  # Read here rather than rendered into this script, so the token never
  # appears in the rendered script, which `chezmoi diff` prints.
  token="$(security find-generic-password "$KEYCHAIN_FLAG" "$id" -a "$account" -w "$KEYCHAIN" 2>/dev/null)" || token=""
  if [[ -z "$token" ]]; then
    _log warning "Skipped the ${name} skill (no license token in the keychain)"
    return 0
  fi

  # The token goes to curl on stdin, not in an argument. Arguments are readable
  # in the process table by any local account for as long as the request runs,
  # and this is a credential that grants downloads against a paid seat. curl's
  # config syntax treats backslash and double quote as escapes.
  token="${token//\\/\\\\}"
  token="${token//\"/\\\"}"
  if ! printf 'header = "%s: %s"\n' "$header" "$token" \
    | curl -fsSL --connect-timeout 10 --max-time 120 -K - -o "$archive" "$url"; then
    # A warning, not a failure. Being offline, or holding a token that has
    # expired, must not abort an apply that has nothing else to do with this
    # vendor, and the copy already on disk keeps working until the next apply
    # retries.
    _log warning "Failed to download the ${name} skill (keeping the installed copy)"
    return 0
  fi

  mkdir -p "$unpacked"
  if ! tar xzf "$archive" -C "$unpacked"; then
    _log warning "Failed to unpack the ${name} skill (keeping the installed copy)"
    return 0
  fi

  if [[ -d "$dest" ]] && diff -rq "$unpacked" "$dest" >/dev/null 2>&1; then
    return 0
  fi

  # Swap rather than write in place, so a file the vendor dropped upstream does
  # not survive here.
  command rm -rf "$dest"
  command mv "$unpacked" "$dest"
  _log success "Installed the ${name} skill"
}

for ((i = 0; i < ${#licensed[@]}; i += 5)); do
  _install_licensed "${licensed[i]}" "${licensed[i + 1]}" "${licensed[i + 2]}" "${licensed[i + 3]}" "${licensed[i + 4]}"
done

# --------------------------------- Agent links ------------------------------ #

for link_dir in ${link_dirs[@]+"${link_dirs[@]}"}; do
  [[ -d "${link_dir%/*}" ]] || continue
  mkdir -p "$link_dir"
  added=0

  for name in ${names[@]+"${names[@]}"}; do
    target="${SKILLS_HOME}/${name}"
    link="${link_dir}/${name}"

    # Only a directory holding a SKILL.md is a skill. A clone that failed
    # leaves a dangling link and a moved upstream folder leaves one without a
    # SKILL.md, so the test is the file rather than the directory. Either way,
    # take back the link if an earlier run made one: the skill has gone away.
    if [[ ! -f "${target}/SKILL.md" ]]; then
      if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
        command rm -f "$link"
        _log success "Removed the ${name} link from ${link_dir} (the skill is no longer installed)"
      fi
      continue
    fi

    [[ -L "$link" && "$link" -ef "$target" ]] && continue

    # Only ever replace a link. A real directory of the same name is somebody
    # else's skill, and clobbering it would be the one destructive thing this
    # script must never do.
    if [[ -e "$link" && ! -L "$link" ]]; then
      _log warning "Skipped linking ${name} into ${link_dir} (a real directory is already there)"
      continue
    fi

    ln -sfn "$target" "$link"
    added=$((added + 1))
  done
  ((added == 0)) || _log success "Linked ${added} skill(s) into ${link_dir}"
done

# ---------------------------------- Pruning --------------------------------- #

# Everything the last run installed that the inventory no longer names. Reading
# a missing ledger as empty is what makes the first run on a machine adopt what
# is already there rather than delete it. A git working tree may hold work that
# was never pushed, so it is reported rather than removed.
if [[ "$managed_list" != "$declared_list" ]]; then
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    _listed "$name" "$declared_list" && continue

    stale="${SKILLS_HOME}/${name}"
    if [[ -d "${stale}/.git" && ! -L "$stale" ]]; then
      _log warning "Kept ${stale} (a git working tree, remove it by hand)"
    elif [[ -e "$stale" || -L "$stale" ]]; then
      command rm -rf "$stale"
      _log success "Removed the ${name} skill (no longer declared)"
    fi
  done <<<"$managed_list"
fi

# Clones no declared skill uses any more. The store belongs to this script
# alone, so anything in it that the inventory does not name is a leftover.
for dir in "$STORE"/*/*; do
  [[ -d "$dir" ]] || continue
  _listed "$dir" "$checkout_list" && continue
  command rm -rf "$dir"
  _log success "Removed the ${dir#"${STORE}/"} clone (no declared skill uses it)"
done
rmdir "$STORE"/*/ 2>/dev/null || true

# Links left pointing into the shared directory at something that is gone,
# whether this run removed it or a hand-run of an installer did. The target
# prefix is the ownership test: a link out to anywhere else belongs to whoever
# made it, and a real directory is not this script's to touch.
for link_dir in ${link_dirs[@]+"${link_dirs[@]}"}; do
  [[ -d "$link_dir" ]] || continue

  for link in "$link_dir"/*; do
    [[ -L "$link" ]] || continue
    [[ -e "$link" ]] && continue
    [[ "$(readlink "$link")" == "${SKILLS_HOME}/"* ]] || continue

    command rm -f "$link"
    _log success "Removed the broken ${link##*/} link from ${link_dir}"
  done
done

# A name that another installer's directory occupies is not recorded, so a
# later run neither replaces nor prunes that directory.
mkdir -p "${LEDGER%/*}"
for name in ${names[@]+"${names[@]}"}; do
  _listed "$name" "$foreign_list" || printf '%s\n' "$name"
done >|"$LEDGER"

# ------------------------------- Health check ------------------------------- #

# A declared skill with no SKILL.md is a skill no agent can load, and nothing
# else on this machine will say so. It happens when a repository is gone or
# renamed, when the source moved the skill and `path` no longer points at one,
# when a clone keeps failing, or when a licensed download has been failing.
# The warnings above appear once, and this names the skill every apply.
broken=0
for ((i = 0; i < ${#names[@]}; i++)); do
  [[ -f "${SKILLS_HOME}/${names[i]}/SKILL.md" ]] && continue
  broken=$((broken + 1))
  _log error "Failed to install the ${names[i]} skill from ${origins[i]}"
done

if ((broken)); then
  _log info "Fix or drop each entry above in .chezmoidata/skills.toml, or run skills:sync if it comes from a watched owner"
fi
