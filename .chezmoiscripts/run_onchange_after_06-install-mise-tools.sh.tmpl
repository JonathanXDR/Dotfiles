#!/bin/bash
set -euo pipefail
{{ template "shell-helpers" . }}

# mise config content hash (triggers a re-run when the tool list changes):
# {{ include "dot_config/mise/config.toml" | sha256sum }}
#
# mise presence is part of the trigger for the same reason as in script 03. mise
# itself arrives through Homebrew, so a run before that happens must not record
# its skip as final.
# mise: {{ output "sh" "-c" "if command -v mise >/dev/null 2>&1 || [ -x /opt/homebrew/bin/mise ] || [ -x /usr/local/bin/mise ]; then echo yes; else echo no; fi" | trim }}

_ensure_brew

if ! _cmd_exists mise; then
  _log warning "Skipped mise-managed tools (mise not installed)"
  exit 0
fi

# mise caches each tool's remote version list for an hour, keyed on the tool
# alone rather than on the settings that pick which build a version resolves to.
# java.shorthand_vendor is one of those, so a vendor change keeps reading the
# old list until the cache expires. Only java's list is dropped, because
# dropping every tool's would turn the sub-second re-run below into a full
# network re-resolve.
#
# One level deep rather than `mise cache clear java`, which takes the whole
# subtree. The per-version directories below it hold the `incomplete` marker
# that tells `mise install` an interrupted install still has to be redone, and
# removing that along with the version list is what leaves a half-downloaded
# java as an empty install directory every later run reads as already there.
find "$(mise -C "$HOME" cache path)/java" -maxdepth 1 -type f -delete 2>/dev/null || true

# The `mise install` command reads ~/.config/mise/config.toml (symlinked to
# this repo) and installs whatever is missing. It never writes back, unlike
# `mise use -g`, which would rewrite that file and fight chezmoi over it.
# Re-runs are sub-second no-ops, so the content hash above is the only thing
# gating this step.
#
# Scoped to $HOME with -C so a project mise.toml in the working directory
# cannot pull in undeclared tools. Leaving that config untrusted would not help:
# mise asks for trust before running [env], [tasks], and [hooks], never before
# reading [tools].
#
# No --yes here, unlike the prune below. On install it is not just prompt
# suppression. With system_deps at its default of "prompt", it authorizes mise
# to install missing system dependencies through Homebrew, behind the Brewfile
# that script 03 owns. Nothing in config.toml declares one today, because only
# vfox-backed plugins can, so this is about the tool added tomorrow.
_log info "Installing mise-managed tools…"
if mise -C "$HOME" install; then
  _log success "Installed mise-managed tools"
else
  _log warning "Failed to install some mise-managed tools (see above)"
fi

# `mise install` only ever adds, so a tool dropped from config.toml keeps its
# install and its shims, and dot_zshenv.tmpl keeps that shim directory on PATH
# for every zsh. Pruning is what makes the removal converge. Project toolchains
# stay safe, because mise tracks every config it has seen
# (~/.local/state/mise/tracked-configs) and keeps any version one of them still
# asks for. The same pass rebuilds the shim directory, so no reshim is needed.
#
# --yes is required here, unlike on the install above. Without it mise asks
# before every removal, and an unattended run counts as a decline, so the prune
# would silently remove nothing.
_log info "Pruning unused tool versions…"
if mise -C "$HOME" prune --yes; then
  _log success "Pruned unused tool versions"
else
  _log warning "Failed to prune unused tool versions (see above)"
fi

# `mise install` treats an existing install directory as proof the tool is
# there, and the `incomplete` marker that would say otherwise lives under the
# java cache tree that the clear above deletes. An apply interrupted while java
# was downloading therefore leaves an empty install directory that every later
# run reads as installed. mise 2026.8.12 taught `mise doctor` to report exactly
# that. Only real problems set a non-zero status, so the standing "new mise
# version available" warning never trips this.
if ! mise -C "$HOME" doctor >/dev/null 2>&1; then
  _log warning "Detected mise problems (run 'mise doctor' for details)"
fi
