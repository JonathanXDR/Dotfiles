<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
{{- /* An NTLM hash in the keychain selects NTLM. Without one, Alpaca uses the
       macOS Kerberos ticket. -no-kerberos keeps the two apart, because a
       Kerberos error ends Alpaca's authentication chain with a 502 instead of
       falling back to NTLM. */}}
{{- $ntlm := includeTemplate "keychain" (list "Proxy" "taarujo6" .keychain_name .keychain_lookup_field) }}
{{- /* Alpaca ignores a malformed value and answers every proxied request with
       a 502, so it has to stop the render instead. */}}
{{- if and $ntlm (not (regexMatch `^[^@:]+@[^@:]+:[0-9a-fA-F]{32}$` $ntlm)) }}
{{-   fail "The Proxy keychain entry must hold the user@DOMAIN:hash value that alpaca -H prints between the quotes (replace it with secret:remove and secret:set, or remove it to use Kerberos)" }}
{{- end }}
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.alpaca</string>

  <!-- The wrapper execs Alpaca, so launchd tracks Alpaca itself and the PID
       file .zshenv checks holds Alpaca's PID. launchctl setenv reaches every
       app launchd starts in this session. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>if [ ! -x "$1" ]; then
  for name in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do
    launchctl unsetenv "$name"
  done
  rm -f "$HOME/.cache/alpaca.pid"
  exit 0
fi
mkdir -p "$HOME/.cache" &amp;&amp; echo $$ &gt;"$HOME/.cache/alpaca.pid"
for name in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do
  launchctl setenv "$name" "$ALPACA_URL"
done
for name in no_proxy NO_PROXY; do
  launchctl setenv "$name" "$NO_PROXY"
done
log="$HOME/Library/Logs/alpaca.log"
[ "$(stat -f %z "$log" 2&gt;/dev/null || echo 0)" -lt 10485760 ] || : &gt;"$log"
exec "$@" 2&gt;&gt;"$log"</string>
    <string>alpaca</string>
    <string>/opt/homebrew/opt/alpaca/bin/alpaca</string>
    <string>-p</string>
    <string>{{ .alpaca_port }}</string>
    <string>-C</string>
    <string>data:application/x-ns-proxy-autoconfig;base64,{{ includeTemplate "alpaca.pac" . | b64enc }}</string>
{{- if $ntlm }}
    <string>-no-kerberos</string>
{{- end }}
  </array>

  <!-- Alpaca ignores proxy variables for its own traffic, so NO_PROXY here
       only feeds the wrapper. The allowlist sends credentials to the corporate
       proxy alone, never to a host Alpaca reached directly that answers with
       a 407. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ALPACA_URL</key>
    <string>http://localhost:{{ .alpaca_port }}</string>
    <key>NO_PROXY</key>
    <string>{{ .no_proxy | html }}</string>
    <key>ALPACA_PROXY_AUTH_ALLOWLIST</key>
    <string>{{ .proxy_host }}</string>
{{- if $ntlm }}
    <key>NTLM_CREDENTIALS</key>
    <string>{{ $ntlm | html }}</string>
{{- end }}
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart after a crash or a fatal error, but not after the wrapper's
       quiet exit for a missing binary. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/alpaca.log</string>
</dict>
</plist>
