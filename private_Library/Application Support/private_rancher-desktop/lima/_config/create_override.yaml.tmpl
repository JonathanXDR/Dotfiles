# Rancher Desktop starts the container engines through sudo and OpenRC, which
# drop the proxy variables, but OpenRC reads /etc/rc.conf.d before every
# service. host.lima.internal is the Mac as seen from the virtual machine.
provision:
- mode: system
  script: |
    #!/bin/sh
    set -eu
    mkdir -p /etc/rc.conf.d
    cat >/etc/rc.conf.d/alpaca-proxy.conf <<'CONF'
    case "${RC_SVCNAME:-}" in
    docker|containerd|buildkitd)
      export http_proxy=http://host.lima.internal:{{ .alpaca_port }} https_proxy=http://host.lima.internal:{{ .alpaca_port }}
      export no_proxy={{ .no_proxy }},host.lima.internal,192.168.5.0/24,10.42.0.0/16,10.43.0.0/16,.svc,.cluster.local
      export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy" NO_PROXY="$no_proxy"
      ;;
    esac
    CONF
    # nerdctl pulls images in a process of its own, started through sudo
    printf 'Defaults env_keep += "http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY"\n' >/etc/sudoers.d/91-alpaca-proxy
    chmod 0440 /etc/sudoers.d/91-alpaca-proxy
