
# Kiro CLI pre block. Must stay first in this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# --------------------------------- Sources ---------------------------------- #

source "${HOME}/.exports"
source "${HOME}/.functions"

# ----------------------------- PATH & Toolchain ----------------------------- #

# Tool directories. Each is prepended, so the last one listed takes priority.
# Coursier is the exception, appended instead so its launchers never shadow a
# same-named binary from Homebrew or mise.
path:add "$HOME/.local/bin"
path:add "$HOME/.cargo/bin"
path:add "$HOME/.rd/bin"
path:add "$HOME/.console-ninja/.bin"
path:add "/Library/Frameworks/Python.framework/Versions/Current/bin"
path:add "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
path:append "$HOME/Library/Application Support/Coursier/bin"
path:add "/opt/homebrew/opt/trash-cli/bin"

# Homebrew (Apple silicon prefix first, Intel prefix as the fallback)
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Per-machine extras from .exports, appended to stay behind everything above
path:append ${(s.:.)PATH_ADD}

# mise (Node, Python, bun, pnpm, global CLIs). Must run after every other PATH
# writer. Activation snapshots PATH and re-derives it from that snapshot on
# each prompt, so anything prepended later outranks the managed toolchain for
# good. Homebrew ships its own node (a dependency of eslint, prettier, and
# vercel), and this ordering keeps that copy behind mise's.
cmd:exists mise && eval "$(mise activate zsh)"

# ------------------------------ Plugins & Aliases --------------------------- #

# The aws plugin prepends '$(aws_prompt_info)' to RPROMPT. Upstream relies on
# oh-my-zsh.sh sourcing lib/theme-and-appearance.zsh for `setopt prompt_subst`,
# and antidote loads plugin files only, so the substitution never runs and the
# string prints literally. Opting out keeps the plugin's aliases and
# completions without the prompt segment.
SHOW_AWS_PROMPT=false

# Oh My Zsh plugins, listed in ~/.plugins and compiled by antidote (see
# plugins:load in .functions). Runs before .aliases on purpose, so .aliases
# stays the authority on any name both of them define. alias:safe still steps
# aside for real commands, just not for plugin aliases (see alias:_taken).
plugins:load

source "${HOME}/.aliases"
source "${HOME}/.completions"

# --------------------------------- Runtime ---------------------------------- #

# Work machines only, since they alone set ALWAYS_PROXY_PROBE to true. The
# proxy-watchd LaunchAgent runs on every network change and rewrites
# .cache/proxy-state whenever the state flips, so a new shell can adopt the
# recorded state instead of probing. Probing is the fallback for a missing or
# unrecognized state file.
if [[ "${ALWAYS_PROXY_PROBE}" == "true" ]]; then
  case "$(cat "${HOME}/.cache/proxy-state" 2>/dev/null)" in
    on)  proxy:set ;;
    off) proxy:unset ;;
    *)   proxy:probe ;;
  esac
fi
[[ "${AUTOSTART_SSH_AGENT}" == "true" ]] && ssh:agent

cmd:exists mise && run:daily mise mise:update
cmd:exists brew && run:daily brew brew:check
[[ -f "${HOME}/.plugins" ]] && run:daily plugins plugins:update

# Kiro CLI post block. Must stay last, after every keybinding and widget above.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"
