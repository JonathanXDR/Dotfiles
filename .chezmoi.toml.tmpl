{{- $machine_type := promptChoiceOnce $ "machine_type" "Machine type" (list "personal" "work") -}}

{{- /* Defaults for this machine type, from the iCloud Drive config */ -}}
{{- $icloudSecrets := joinPath .chezmoi.homeDir "Documents/General/Developer/.dotfiles" -}}
{{- $icloudConfigPath := joinPath $icloudSecrets "config.toml" -}}
{{- $machineConfig := dict -}}
{{- if stat $icloudConfigPath -}}
{{-   $allConfig := output "cat" $icloudConfigPath | fromToml -}}
{{-   if hasKey $allConfig $machine_type -}}
{{-     $machineConfig = index $allConfig $machine_type -}}
{{-   end -}}
{{- end -}}

{{- /* Every config key with its fallback value. A value from config.toml wins,
      otherwise promptStringOnce asks for it and caches the answer in
      chezmoi.toml. $sharedKeys resolve first, then $workKeys on work machines. */ -}}
{{- $config := dict
      "email"                      ""
      "name"                       ""
      "gpg_key"                    ""
      "proxy_host"                 ""
      "proxy_port"                 ""
      "proxy_protocol"             "http"
      "proxy_dns"                  ""
      "proxy_network_service"      ""
      "no_proxy"                   "localhost,127.0.0.1"
      "no_proxy_dns"               ""
      "ssl_bundle_keychain_certs"  ""
      "ssl_bundle_remote_certs"    ""
      "enterprise_domain"          ""
      "forgeops_path"              "" -}}

{{- /* Text `chezmoi init` shows for keys config.toml does not supply */ -}}
{{- $configPrompts := dict
      "email"                      "Git email address"
      "name"                       "Git full name"
      "gpg_key"                    "GPG signing key ID (leave empty to disable signing)"
      "proxy_host"                 "Proxy host (e.g. proxy.company.com)"
      "proxy_port"                 "Proxy port (e.g. 8080)"
      "proxy_protocol"             "Proxy protocol (http/https/socks5)"
      "proxy_dns"                  "DNS servers to use while the proxy is on (comma-separated, leave empty for none)"
      "proxy_network_service"      "Network service the DNS switch applies to (e.g. Wi-Fi, leave empty to disable switching)"
      "no_proxy"                   "Hosts that bypass the proxy (comma-separated)"
      "no_proxy_dns"               "DNS servers to use while the proxy is off (comma-separated, leave empty for none)"
      "ssl_bundle_keychain_certs"  "SSL bundle certificate CNs in the System keychain (comma-separated, leave empty for none)"
      "ssl_bundle_remote_certs"    "SSL bundle remote certificate URLs to download (comma-separated, leave empty for none)"
      "enterprise_domain"          "Enterprise domain (leave empty for none)"
      "forgeops_path"              "ForgeOps repo path (e.g. $HOME/Developer/Git/Swisscom/wfidb)" -}}

{{- /* Keys resolved on every machine type */ -}}
{{- $sharedKeys := list "email" "name" "gpg_key" -}}

{{- /* Keys resolved only on work machines */ -}}
{{- $workKeys := list "proxy_host" "proxy_port" "proxy_protocol" "proxy_dns" "proxy_network_service" "no_proxy" "no_proxy_dns" "ssl_bundle_keychain_certs" "ssl_bundle_remote_certs" "enterprise_domain" "forgeops_path" -}}

{{- /* Resolve the keys this machine type needs. config.toml wins, otherwise
      prompt once with the fallback above as the default. Personal machines
      skip the work keys and keep their fallbacks. */ -}}
{{- $keys := $sharedKeys -}}
{{- if eq $machine_type "work" -}}
{{-   $keys = concat $sharedKeys $workKeys -}}
{{- end -}}
{{- range $key := $keys -}}
{{-   if hasKey $machineConfig $key -}}
{{-     $_ := set $config $key (index $machineConfig $key) -}}
{{-   else -}}
{{-     $_ := set $config $key (promptStringOnce $ $key (index $configPrompts $key) (index $config $key)) -}}
{{-   end -}}
{{- end -}}

{{- /* Master password for the dotfiles keychain. Leave it empty and the
       keychain follows the login session's unlock state, so nothing is
       prompted for during use. Set one and the keychain starts locked and
       asks once per session. Either answer is cached in chezmoi.toml. */ -}}
{{- $keychain_password := promptStringOnce $ "keychain_password" "Master password for the dotfiles keychain (leave empty for no password)" "" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}
mode = "symlink"

[data]
  email = {{ index $config "email" | quote }}
  name = {{ index $config "name" | quote }}
  gpg_key = {{ index $config "gpg_key" | quote }}
  machine_type = {{ $machine_type | quote }}
  icloud_secrets = {{ $icloudSecrets | quote }}

  # Proxy & network (populated on work machines, defaults elsewhere)
  always_proxy_probe = {{ eq $machine_type "work" }}
  proxy_host = {{ index $config "proxy_host" | quote }}
  proxy_port = {{ index $config "proxy_port" | quote }}
  proxy_protocol = {{ index $config "proxy_protocol" | quote }}
  proxy_dns = {{ index $config "proxy_dns" | quote }}
  proxy_network_service = {{ index $config "proxy_network_service" | quote }}
  no_proxy = {{ index $config "no_proxy" | quote }}
  no_proxy_dns = {{ index $config "no_proxy_dns" | quote }}

  # SSL & enterprise (populated on work machines, empty elsewhere)
  ssl_bundle_keychain_certs = {{ index $config "ssl_bundle_keychain_certs" | quote }}
  ssl_bundle_remote_certs = {{ index $config "ssl_bundle_remote_certs" | quote }}
  enterprise_domain = {{ index $config "enterprise_domain" | quote }}
  forgeops_path = {{ index $config "forgeops_path" | quote }}

  # Master password for the dotfiles keychain (empty means no password, so the
  # keychain follows the login session's unlock state)
  keychain_password = {{ $keychain_password | quote }}

[scriptEnv]
  HOMEBREW_NO_AUTO_UPDATE = "1"
  HOMEBREW_NO_INSTALL_CLEANUP = "1"
  NONINTERACTIVE = "1"

[[textconv]]
  pattern = "**/*.json"
  command = "jq"
  args = ["."]

# Zed's settings are JSONC. jq exits non-zero on the comments and trailing
# commas, and that aborts the entire diff walk, hiding every target chezmoi has
# not reached yet. Passing this one file through untouched keeps jq formatting
# everywhere else. chezmoi matches the longest pattern, so this wins over the
# rule above.
[[textconv]]
  pattern = "**/zed/settings.json"
  command = "cat"
