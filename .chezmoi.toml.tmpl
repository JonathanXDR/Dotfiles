{{- $machine_type := promptChoiceOnce $ "machine_type" "Machine type" (list "personal" "work") -}}

{{- /* Defaults for this machine type, from the iCloud Drive config */ -}}
{{- $icloudSecrets := joinPath .chezmoi.homeDir "Documents/General/Developer/.dotfiles" -}}
{{- $icloudConfigPath := joinPath $icloudSecrets "config.toml" -}}
{{- $machineConfig := dict -}}
{{- if stat $icloudConfigPath -}}
{{-   $allConfig := include $icloudConfigPath | fromToml -}}
{{-   if hasKey $allConfig $machine_type -}}
{{-     $machineConfig = index $allConfig $machine_type -}}
{{-   end -}}
{{- end -}}

{{- /* Every config key with its fallback value, which is also the default the
      prompt below offers. */ -}}
{{- $config := dict
      "email"                      ""
      "name"                       ""
      "gpg_key"                    ""
      "enterprise_domain"          "" -}}

{{- /* Prompt text `chezmoi init` shows for keys config.toml omits */ -}}
{{- $configPrompts := dict
      "email"                      "Git email address"
      "name"                       "Git full name"
      "gpg_key"                    "GPG signing key ID (leave empty to disable signing)"
      "enterprise_domain"          "Enterprise domain (leave empty for none)" -}}

{{- /* Keys resolved on every machine type */ -}}
{{- $sharedKeys := list "email" "name" "gpg_key" -}}

{{- /* Keys resolved only on work machines */ -}}
{{- $workKeys := list "enterprise_domain" -}}

{{- /* Resolve the keys this machine type needs. A value from config.toml wins,
      otherwise promptStringOnce asks for it and caches the answer in
      chezmoi.toml. Personal machines skip the work keys and keep their
      fallbacks. */ -}}
{{- $keys := $sharedKeys -}}
{{- if eq $machine_type "work" -}}
{{-   $keys = concat $sharedKeys $workKeys -}}
{{- end -}}
{{- range $key := $keys -}}
{{-   if hasKey $machineConfig $key -}}
{{-     $_ := set $config $key (index $machineConfig $key) -}}
{{-   else -}}
{{-     $_ := set $config $key (promptStringOnce $ $key (index $configPrompts $key) (index $config $key)) -}}
{{-   end -}}
{{- end -}}

{{- /* Master password for the dotfiles keychain. Leave it empty and the
       keychain follows the login session's unlock state, so it never prompts.
       Set one and the keychain starts locked and prompts once per session.
       Either answer is cached in chezmoi.toml. */ -}}
{{- $keychain_password := promptStringOnce $ "keychain_password" "Master password for the dotfiles keychain (leave empty for no password)" "" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}
mode = "symlink"

[data]
  email = {{ index $config "email" | quote }}
  name = {{ index $config "name" | quote }}
  gpg_key = {{ index $config "gpg_key" | quote }}
  machine_type = {{ $machine_type | quote }}
  icloud_secrets = {{ $icloudSecrets | quote }}

  # Enterprise (populated on work machines, empty elsewhere)
  enterprise_domain = {{ index $config "enterprise_domain" | quote }}

  # Master password for the dotfiles keychain (empty means no password, so the
  # keychain follows the login session's unlock state)
  keychain_password = {{ $keychain_password | quote }}

[scriptEnv]
  HOMEBREW_NO_AUTO_UPDATE = "1"
  HOMEBREW_NO_INSTALL_CLEANUP = "1"
  NONINTERACTIVE = "1"

[[textconv]]
  pattern = "**/*.json"
  command = "jq"
  args = ["."]

# Zed's settings are JSONC. jq exits non-zero on the comments and trailing
# commas, and that aborts the entire diff walk, hiding every target chezmoi has
# not reached yet. Passing this one file through untouched keeps jq formatting
# everywhere else. chezmoi matches the longest pattern, so this wins over the
# rule above.
[[textconv]]
  pattern = "**/zed/settings.json"
  command = "cat"
