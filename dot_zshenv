# Sourced by every zsh, interactive or not. Keep it to PATH essentials.
# Anything interactive belongs in .zshrc.

# Collapse duplicate PATH entries (nested shells re-source this file)
typeset -gU PATH path

# mise shims, so editors, LaunchAgents, and `zsh -c` scripts resolve the same
# toolchain as an interactive shell (non-interactive shells never read .zshrc).
# Interactive shells also run `mise activate zsh`, which prepends the resolved
# tool directories ahead of these shims.
[[ -d "$HOME/.local/share/mise/shims" ]] && path=("$HOME/.local/share/mise/shims" $path)
