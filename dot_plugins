# --------------------------------- History ---------------------------------- #

# After helm, so `h` resolves to history rather than helm. Two of the three
# plugins claiming the name agree on history, and helm keeps hin/hup/hun/hls.
ohmyzsh/ohmyzsh path:plugins/history

# -------------------------------- Fun & Dumb -------------------------------- #

ohmyzsh/ohmyzsh path:plugins/lol

# ------------------------------ Alias Discovery ----------------------------- #

# Both read the alias table at call time, so they see everything above plus
# .aliases. Worth having once the table runs to several hundred entries.
ohmyzsh/ohmyzsh path:plugins/aliases
ohmyzsh/ohmyzsh path:plugins/alias-finder

# ------------------------------- Key Bindings ------------------------------- #

# Last, because these two are the only entries that touch the keymap, and
# .completions sources zsh-autocomplete, zsh-autosuggestions and
# zsh-syntax-highlighting after them.
#
#   fzf        Ctrl+R history, Ctrl+T files, Alt+C cd, and ** completion.
#              Replaces the stock history-incremental-search-backward,
#              transpose-chars and capitalize-word on those keys.
#   globalias  SPACE expands the word to its left, Ctrl+SPACE inserts a
#              literal space.
ohmyzsh/ohmyzsh path:plugins/fzf conditional:have:tty
ohmyzsh/ohmyzsh path:plugins/globalias
