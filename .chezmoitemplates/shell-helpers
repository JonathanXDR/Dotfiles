# Shared helper functions for chezmoi run scripts (bash-compatible).

# Logger with a colored "<Level>:" prefix followed by an action-first message.
# The bash counterpart of log() in dot_functions, which documents the message
# convention in full. Keep the convention and the levels in sync.
_log() {
  local level="$1"; shift
  local red='' green='' yellow='' blue='' gray='' reset=''

  if [[ -t 2 ]]; then
    red='\033[0;31m' green='\033[0;32m' yellow='\033[0;33m'
    blue='\033[0;34m' gray='\033[0;90m' reset='\033[0m'
  fi

  case "$level" in
    error|red)      printf "${red}Error:${reset}   %s\n" "$*" >&2 ;;
    success|green)  printf "${green}Success:${reset} %s\n" "$*" ;;
    warning|yellow) printf "${yellow}Warning:${reset} %s\n" "$*" >&2 ;;
    info|blue)      printf "${blue}Info:${reset}    %s\n" "$*" ;;
    debug)          [[ -z "${DEBUG:-}" ]] || printf "${gray}Debug:${reset}   %s\n" "$*" >&2 ;;
    *)              echo "$level" "$@" ;;
  esac
}

_cmd_exists() { command -v "$1" &>/dev/null; }

_ensure_brew() {
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

_ensure_icloud() {
  local path="$1"
  [[ -e "$path" ]] || return 1
  _cmd_exists brctl || return 0

  # brctl returns once the downloads are queued and offers no wait flag, so
  # there is nothing to sleep for. An evicted file keeps its name and mode as a
  # dataless placeholder, so the callers' chmod reaches it either way, and
  # reading one materializes it on demand.
  local err
  if ! err="$(brctl download "$path" 2>&1)"; then
    _log warning "Failed to start the iCloud download of $path ($err)"
  fi
}
