# ---------------------------- Shell & PATH Utils ---------------------------- #

# Logger with a colored "<Level>:" prefix followed by an action-first message.
# Convention:
#   1. Every message starts with a verb, in one of four forms.
#      a. Past tense for completed work (Imported / Skipped / Verified /
#         Detected / Removed).
#      b. "Failed to <verb>" for failures.
#      c. Present participle plus a single … for work in progress
#         (Installing… / Reading…).
#      d. An imperative remedy hint telling the user what to do next
#         (Add tokens manually via 'secret:set' / Run 'brew bundle cleanup'
#         to remove them).
#      The … belongs to form (c) alone, so a past-tense message never
#      carries one.
#   2. The message body MUST NOT contain a formatting colon, since the only
#      colon in the rendered line is the one in the "<Level>:" prefix. Put
#      the detail in parentheses instead.
#      ✓ "Success: Imported 12 secrets"
#      ✗ "Success: Imported: 12 secrets"      (two colons)
#      ✗ "Warning: Detected packages:"        (trailing list-colon)
#   Colons inside data values (URLs, function names like `secret:rename`,
#   port numbers like `:8080`) are fine, since those aren't formatting.
log() {
  local level="$1"; shift
  local red green yellow blue gray reset

  if [[ -t 2 ]]; then
    red='\033[0;31m' green='\033[0;32m' yellow='\033[0;33m'
    blue='\033[0;34m' gray='\033[0;90m' reset='\033[0m'
  fi

  case "$level" in
    error|red)      printf "${red}Error:${reset}   %s\n" "$*" >&2 ;;
    success|green)  printf "${green}Success:${reset} %s\n" "$*" ;;
    warning|yellow) printf "${yellow}Warning:${reset} %s\n" "$*" >&2 ;;
    info|blue)      printf "${blue}Info:${reset}    %s\n" "$*" ;;
    debug)          [[ -n "${DEBUG:-}" ]] && printf "${gray}Debug:${reset}   %s\n" "$*" >&2 ;;
    *)              echo "$level" "$@" ;;
  esac
}

# Retry a command up to N times with a delay between attempts (from bash-it)
# Usage: retry <attempts> <delay_seconds> <command...>
retry() {
  local attempts="$1" delay="$2"; shift 2
  local i
  for (( i = 1; i <= attempts; i++ )); do
    if "$@"; then
      return 0
    fi
    (( i < attempts )) && sleep "$delay"
  done
  return 1
}

cmd:exists() {
  [[ $# -eq 1 ]] || {
    echo "Usage: cmd:exists <command>" >&2
    return 1
  }
  command -v "$1" &>/dev/null
}

# Internal: true when a binary, function, or builtin already owns this name.
#
# Deliberately narrower than cmd:exists, which also resolves aliases. The Oh My
# Zsh bundle loads before .aliases, so `command -v` would report every plugin
# alias as an existing command and .aliases would step aside for all of them.
# The guards exist to stop a real command being shadowed. Sitting on top of a
# plugin alias is intended, because .aliases owns the names it sets.
# Usage: alias:_taken <name>
alias:_taken() {
  (( ${+commands[$1]} + ${+functions[$1]} + ${+builtins[$1]} ))
}

# Define an alias only if no command with that name already exists.
# Warns when skipped, so shadowed commands stay visible.
# Usage: alias:safe <name>='<value>'
alias:safe() {
  local name="${1%%=*}"
  if alias:_taken "$name"; then
    log warning "Skipped alias '${name}' (would shadow existing command)"
  else
    alias:_set "$1"
  fi
}

# Silent counterpart to alias:safe, for polyfills where the absence
# of the real command is what triggers the alias.
# Usage: alias:fallback <name>='<value>'
alias:fallback() {
  alias:_taken "${1%%=*}" || alias:_set "$1"
}

# Internal: set an alias and warn if its target is unavailable.
# Resolves the target the way zsh would at expansion time:
#   (z) tokenize, (Q) dequote escapes, (e) expand parameters.
# Usage: alias:_set <name>='<value>'
alias:_set() {
  local -a parts=( ${(z)${1#*=}} )
  local target="${(eQ)parts[1]}"
  [[ -n "$target" ]] && ! cmd:exists "$target" \
    && log warning "Skipped alias '${1%%=*}' (target '${target}' is not available)"
  alias "$1"
}

# Drop suffix aliases whose target command is not installed. The common-aliases
# plugin ships 35 of them for a Linux desktop (mplayer, acroread, xchm, djview,
# xdvi, gv, unace, unrar), and the ones with no viewer here would fail the first
# time they were used. Resolves the target the same way alias:_set does.
# Usage: alias:prune-suffix
alias:prune-suffix() {
  local suffix target
  local -a parts
  for suffix in ${(k)saliases}; do
    parts=( ${(z)saliases[$suffix]} )
    target="${(eQ)parts[1]}"
    if [[ -n "$target" ]] && ! cmd:exists "$target"; then
      unalias -s -- "$suffix"
    fi
  done
}

# List every alias currently sitting on top of a real binary. The plugin bundle
# has no equivalent of alias:safe, so this is how a plugin update that claims a
# new command name stays visible. Deliberate shadows from .aliases appear here
# too, so read the output rather than acting on it directly.
# Usage: alias:shadows
alias:shadows() {
  local name binary
  for name in ${(ko)aliases}; do
    binary="$(whence -p -- "$name" 2>/dev/null)" || continue
    printf '%-14s %-44s %s\n' "$name" "${aliases[$name]}" "$binary"
  done
}

# Run a command at most once every 24 hours, gated by a stamp file.
# Usage: run:daily <name> <command...>
run:daily() {
  local name="$1"; shift
  local stamp="${HOME}/.cache/daily/${name}"
  # `mh-24` also matches a stamp dated in the future (clock skew, restored
  # backup), which would gate the command off forever, so require a positive
  # age. The cost is that a second shell starting in the same wall-clock second
  # repeats the run once, which is cheaper than a permanently skipped update.
  local -a fresh=( ${stamp}(N.mh-24ms+0) )
  (( ${#fresh} )) && return 0

  mkdir -p "${stamp:h}"
  "$@" && touch "$stamp"
}

# Prepend directories to PATH (skips missing or duplicate entries)
path:add() {
  local dir
  for dir in "$@"; do
    [[ -d "$dir" ]] && case ":$PATH:" in
      *":$dir:"*) ;;
      *) export PATH="$dir:$PATH" ;;
    esac
  done
}

# Append directories to PATH (skips missing or duplicate entries)
path:append() {
  local dir
  for dir in "$@"; do
    [[ -d "$dir" ]] && case ":$PATH:" in
      *":$dir:"*) ;;
      *) export PATH="$PATH:$dir" ;;
    esac
  done
}

# Create a new directory and enter it
mkd() {
  mkdir -p "$@" && cd "${@[-1]}" || return
}

# Change to the directory of the frontmost Finder window
cdf() {
  cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')" || return
}

# -------------------------------- Zsh Plugins ------------------------------- #

# Conditional guards for the Oh My Zsh bundle. antidote calls the function named
# in a `conditional:` annotation with no arguments and wraps that entry in a
# plain `if <name>; then ... fi`, so the tool a plugin needs has to be encoded
# in the guard's own name. Each plugin listed here targets a tool that is not
# installed yet, so its entry costs one test per shell until the tool arrives.
local _tool
for _tool in mongocli multipass pre-commit sbt terraform; do
  functions[have:${_tool}]="cmd:exists ${_tool}"
done
unset _tool

# Rails needs its own guard rather than a bare cmd:exists. macOS ships
# /usr/bin/rails, a stub whose only job is to print "Rails is not currently
# installed", so the plain test always succeeds and the plugin would load its 73
# aliases on a machine with no Rails.
have:rails() {
  local bin
  bin="$(whence -p rails)" || return 1
  [[ "$bin" != "/usr/bin/rails" ]]
}

# fzf's setup is pure ZLE. It evaluates `fzf --zsh`, which saves the shell
# options and restores them afterwards. A shell with no terminal has no ZLE to
# restore, so `zsh -ic` prints "can't change option: zle" twice. Such a shell
# has no use for key bindings anyway, so gate the plugin on a real tty.
have:tty() {
  [[ -t 0 ]]
}

# Update the cloned plugin repositories, then rebuild the bundle from them.
#
# Nothing else does this. antidote clones a plugin once and never revisits it,
# so the Oh My Zsh checkout would otherwise stay at whatever commit it had on
# the day it was cloned. Runs from run:daily in .zshrc, on the same 24-hour
# stamp as mise:update and brew:check. The four Homebrew plugins in .completions
# are unaffected, because `brew upgrade` already covers those.
# Usage: plugins:update
plugins:update() {
  local antidote="${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"
  local bundle="${HOME}/.cache/zsh/plugins.zsh"
  local output

  [[ -f "$antidote" && -f "${HOME}/.plugins" ]] || return 0
  source "$antidote"

  if ! output=$(antidote update 2>&1 </dev/null); then
    log warning "Failed to update zsh plugins"
    print -r -- "$output" >&2
    # Return 0 so run:daily still stamps the day, matching mise:update. An
    # offline laptop retries tomorrow rather than on every new shell.
    return 0
  fi

  # Recompile against the updated clones. Rebuilt in place rather than deleted,
  # because if antidote could not regenerate it, deleting would leave the next
  # shell with no plugins, while an older bundle still works. This shell has
  # already sourced the old file, so the new one takes effect next time.
  if ! output=$(antidote bundle < "${HOME}/.plugins" 2>&1 >| "${bundle}.new"); then
    log warning "Failed to rebuild the plugin bundle (keeping the current one)"
    print -r -- "$output" >&2
    command rm -f "${bundle}.new"
    return 0
  fi
  command mv -f "${bundle}.new" "$bundle"

  log success "Updated zsh plugins"
  return 0
}

# Load the Oh My Zsh bundle listed in ~/.plugins.
#
# antidote compiles that list into one flat file under ~/.cache/zsh. antidote
# itself is sourced only when the list is newer than the compiled file, so a
# normal startup reads a single script and does no plugin resolution. Deleting
# the compiled file forces a rebuild.
#
# Called from .zshrc before .aliases, which is the authority on every name it
# also defines. Sourcing the bundle inside a function is deliberate and safe:
# aliases, functions and `typeset -g` values all survive it, and the only value
# that stops reaching the shell is the git plugin's `git_version` scratch
# variable.
# Usage: plugins:load
plugins:load() {
  local list="${HOME}/.plugins"
  local bundle="${HOME}/.cache/zsh/plugins.zsh"
  local antidote="${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"

  [[ -f "$list" ]] || return 0

  # The docker, kubectl, helm, uv and gh plugins write generated completions
  # here on first use, so it has to exist and sit on fpath before they load.
  # .completions rebuilds fpath afterwards but keeps this entry.
  export ZSH_CACHE_DIR="${HOME}/.cache/oh-my-zsh"
  [[ -d "${ZSH_CACHE_DIR}/completions" ]] || mkdir -p "${ZSH_CACHE_DIR}/completions"
  fpath=("${ZSH_CACHE_DIR}/completions" $fpath)

  # zsh's completion cache, which several plugins reach for at load time via
  # _retrieve_cache/_store_cache. It is off by default, and without it the
  # composer plugin re-runs `composer global config bin-dir` on every shell to
  # find its vendor path, measured at 236 ms against 6 ms once the cache
  # answers. It has to be set here rather than in .completions, because the
  # plugins ask for it while this function is still running.
  zstyle ':completion:*' use-cache on
  zstyle ':completion:*' cache-path "${ZSH_CACHE_DIR}/zcompcache"

  # Several plugins call compdef as they load, to give their aliases the
  # completion of the command behind them. compinit does not run until
  # .completions, which has to stay last because zsh-syntax-highlighting only
  # wraps widgets that already exist. Queue those calls and let .completions
  # replay them. Running compinit early instead does not work, because a second
  # compinit discards everything registered against the first.
  typeset -ga COMPDEF_DEFERRED=()
  (( ${+functions[compdef]} )) || \
    compdef() { COMPDEF_DEFERRED+=( "${(j: :)${(q)@}}" ) }

  if [[ ! "$bundle" -nt "$list" && -f "$antidote" ]]; then
    [[ -d "${bundle:h}" ]] || mkdir -p "${bundle:h}"
    source "$antidote"
    # Write then move, as plugins:update does. `>|` truncates the bundle before
    # antidote runs, so a failed rebuild would leave an empty file that the next
    # line sources and whose mtime then defeats the check above for good.
    if antidote bundle < "$list" >| "${bundle}.new"; then
      command mv -f "${bundle}.new" "$bundle"
    else
      command rm -f "${bundle}.new"
    fi
  fi

  [[ -f "$bundle" ]] && source "$bundle"
  return 0
}

# ----------------------------- Files & Archives ----------------------------- #

# Create a .tar.gz archive (zopfli for small inputs, otherwise pigz or gzip)
# Usage: targz <path...>
targz() {
  local tmpFile="${1%/}.tar"
  tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

  local size
  size=$(stat -f"%z" "${tmpFile}" 2>/dev/null)

  local cmd=""
  if (( size < 52428800 )) && cmd:exists zopfli; then
    cmd="zopfli"
  elif cmd:exists pigz; then
    cmd="pigz"
  else
    cmd="gzip"
  fi

  log info "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…"
  "${cmd}" -v "${tmpFile}" || return 1
  [[ -f "${tmpFile}" ]] && command rm -f "${tmpFile}"

  local zippedSize
  zippedSize=$(stat -f"%z" "${tmpFile}.gz" 2>/dev/null)

  log success "Created ${tmpFile}.gz ($((zippedSize / 1000)) kB)"
}

# Show the size of a file, or the total size of a directory
fs() {
  if (( $# )); then
    du -sh -- "$@"
  else
    du -sh .[^.]*(N) ./*(N)
  fi
}

# Create a base64 data URL from a file
# Usage: dataurl <file>
dataurl() {
  [[ -f "${1:-}" ]] || { log error "Failed to encode (needs an existing file, run 'dataurl <file>')"; return 1; }
  local mimeType
  mimeType=$(file -b --mime-type "$1")
  if [[ $mimeType == text/* ]]; then
    mimeType="${mimeType};charset=utf-8"
  fi
  echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Serve the current directory over HTTP and open it once it answers
# Usage: server [port]
server() {
  local port="${1:-8000}"
  { retry 5 1 curl -fs "http://localhost:${port}/" -o /dev/null && open "http://localhost:${port}/"; } &
  python3 -m http.server "${port}"
}

# Compare the original and gzipped size of a file
# Usage: gz <file>
gz() {
  [[ -f "${1:-}" ]] || { log error "Failed to compare (needs an existing file, run 'gz <file>')"; return 1; }
  local origsize
  origsize=$(wc -c < "$1")
  local gzipsize
  gzipsize=$(gzip -c "$1" | wc -c)
  local ratio
  ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
  printf "orig: %d bytes\n" "$origsize"
  printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Colored tree view, skipping TREE_IGNORE paths, paged through less
trec() {
  tree -aC -I "${TREE_IGNORE}" --dirsfirst "$@" | less -FRNX
}

# Same tree view as trec, without color or paging
tre() {
  tree -a -I "${TREE_IGNORE}" --dirsfirst "$@"
}

