}

# -------------------------- Networking, TLS & DNS --------------------------- #

# Run `dig` and show only the answer section
# Usage: digga <domain>
digga() {
  dig +nocmd "$1" any +multiline +noall +answer
}

# Show every name (common name and SANs) in a domain's TLS certificate
# Usage: getcertnames <domain>
getcertnames() {
  if [[ -z "${1}" ]]; then
    log error "Failed to read certificate names (no domain given)"
    return 1
  fi

  local domain="${1}"
  echo "Testing ${domain}…"
  echo ""

  local tmp
  tmp=$(printf 'GET / HTTP/1.0\nEOT\n' \
    | openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1)

  if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
    local certText
    certText=$(openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
      no_serial, no_sigdump, no_signame, no_validity, no_version" <<< "${tmp}")
    echo "Common Name:"
    echo ""
    grep "Subject:" <<< "${certText}" | sed -e "s/^.*CN=//" -e "s/\/emailAddress=.*//"
    echo ""
    echo "Subject Alternative Name(s):"
    echo ""
    grep -A 1 "Subject Alternative Name:" <<< "${certText}" \
      | sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
    return 0
  else
    log error "Failed to find a certificate for ${domain}"
    return 1
  fi
}

# Bundle corporate CA certificates into one PEM file for NODE_EXTRA_CA_CERTS.
# Sources are SSL_BUNDLE_KEYCHAIN_CERTS (common names in the System keychain)
# and SSL_BUNDLE_REMOTE_CERTS (URLs), both comma-separated.
# Usage: ssl:bundle [output_path]
ssl:bundle() {
  local output="${1:-$HOME/.ssl/ca-bundle.pem}"
  mkdir -p "${output:h}"

  local tmp="$(mktemp)"
  # Bake the path in: a function-scoped EXIT trap runs after locals are popped,
  # so a deferred "$tmp" would expand to the empty string and remove nothing.
  trap "command rm -f ${(q)tmp}" EXIT
  local cert_count=0

  local -a keychain_certs
  IFS=',' read -rA keychain_certs <<< "${SSL_BUNDLE_KEYCHAIN_CERTS:-}"
  local cn
  for cn in "${keychain_certs[@]}"; do
    cn="${cn## }"; cn="${cn%% }"
    [[ -z "$cn" ]] && continue
    if security find-certificate -c "$cn" -p /Library/Keychains/System.keychain >> "$tmp" 2>/dev/null; then
      ((cert_count++))
    else
      log warning "Skipped $cn (not in system keychain)"
    fi
  done

  local -a remote_certs
  IFS=',' read -rA remote_certs <<< "${SSL_BUNDLE_REMOTE_CERTS:-}"
  local -a curl_args=(-fsSL)
  [[ -n "${http_proxy:-}" ]] && curl_args+=(--proxy "$http_proxy")

  local url raw
  for url in "${remote_certs[@]}"; do
    url="${url## }"; url="${url%% }"
    [[ -z "$url" ]] && continue
    raw="$(mktemp)"

    if ! curl "${curl_args[@]}" -o "$raw" "$url"; then
      log warning "Failed to download ${url:t}"
      command rm -f "$raw"
      continue
    fi

    # Accept either encoding, PEM first then DER
    if openssl x509 -inform PEM -in "$raw" -outform PEM >> "$tmp" 2>/dev/null \
    || openssl x509 -inform DER -in "$raw" -outform PEM >> "$tmp" 2>/dev/null; then
      ((cert_count++))
    else
      log warning "Skipped ${url:t} (not a valid PEM or DER certificate)"
    fi
    command rm -f "$raw"
  done

  if ((cert_count == 0)); then
    log error "Failed to bundle any certificates"
    return 1
  fi

  mv "$tmp" "$output"
  log success "Bundled $cert_count certificate(s) into $output"
}

# Point a network service at a specific set of DNS servers.
# Usage: dns:change <network_service> <comma_separated_dns_ips>
dns:change() {
  if (($# < 2)); then
    echo "Usage: dns:change <network_service> <comma_separated_dns_ips>" >&2
    return 1
  fi

  local network_service="$1"
  local -a nameservers
  IFS=',' read -rA nameservers <<<"$2"

  sudo networksetup -setdnsservers "${network_service}" "${nameservers[@]}"
}

# Cisco VPN binary path (set via CISCO_VPN_BIN in .exports)
_CISCO_VPN_BIN="${CISCO_VPN_BIN}"

_vpn:require-cli() {
  [[ -x "$_CISCO_VPN_BIN" ]] || {
    log warning "Skipped operation (Cisco VPN CLI not found at $_CISCO_VPN_BIN)"
    return 1
  }
}

vpn:state() {
  _vpn:require-cli || return 1
  "$_CISCO_VPN_BIN" state 2>/dev/null
}

vpn:hosts() {
  _vpn:require-cli || return 1
  "$_CISCO_VPN_BIN" hosts
}

# True when Cisco reports a connected state, in either output format
# ("state: connected" or a bare "connected" line).
vpn:is-connected() {
  vpn:state | grep -Eqi '^[[:space:]]*state[[:space:]]*:[[:space:]]*connected([[:space:]]|$)|^[[:space:]]*connected([[:space:]]|$)'
}

vpn:internet-ok() {
  curl -fsSIL --connect-timeout 3 --max-time 5 \
    https://www.google.com/generate_204 >/dev/null 2>&1
}

vpn:google-ok() {
  curl -fsSIL --connect-timeout 3 --max-time 5 \
    https://accounts.google.com >/dev/null 2>&1
}

# True when the plain connectivity check still answers but accounts.google.com
# does not, the signature of the broken TLS state the Cisco client leaves.
vpn:google-broken() {
  vpn:internet-ok && ! vpn:google-ok
}

# Disconnect and reconnect the VPN to clear the broken TLS state, stopping
# early if the disconnect alone was enough.
vpn:refresh() {
  _vpn:require-cli || return 1

  log info "Reading Cisco state before refresh…"
  vpn:state || true

  log info "Disconnecting Cisco VPN…"
  "$_CISCO_VPN_BIN" disconnect >/dev/null 2>&1 || true
  sleep 3

  log info "Reading Cisco state after disconnect…"
  vpn:state || true

  if ! vpn:google-broken; then
    log success "Cleared broken TLS state (after disconnect)"
    return 0
  fi

  log info "Reconnecting Cisco VPN (MFA may be required)…"
  "$_CISCO_VPN_BIN" connect
  local rc=$?

  log info "Reading Cisco state after connect attempt…"
  vpn:state || true

  if [[ $rc -ne 0 ]]; then
    log warning "Failed to connect (returned $rc, likely canceled, MFA pending, or blocked)"
  fi

  if vpn:google-broken; then
    log error "Failed to refresh Drive (still broken)"
    return 1
  fi

  log success "Verified Drive works after refresh"
}

# Disconnect without reconnecting, which is often enough on its own.
vpn:soft-refresh() {
  _vpn:require-cli || return 1

  log info "Reading Cisco state before soft refresh…"
  vpn:state || true

  log info "Disconnecting Cisco VPN (soft refresh)…"
  "$_CISCO_VPN_BIN" disconnect >/dev/null 2>&1 || true
  sleep 3

  log info "Reading Cisco state after soft refresh…"
  vpn:state || true

  if vpn:google-broken; then
    log warning "Failed to soft-refresh Drive (still broken)"
    return 1
  fi

  log success "Verified Drive works after disconnect-only soft refresh"
}

# Soft refresh, then reconnect to a named host.
# Usage: vpn:full-refresh [host]
vpn:full-refresh() {
  local vpn_host="${1:-${VPN_DEFAULT_HOST}}"
  _vpn:require-cli || return 1

  if [[ -z "$vpn_host" ]]; then
    log warning "Skipped full refresh (no host given and VPN_DEFAULT_HOST is unset)"
    return 1
  fi

  vpn:soft-refresh || true
  log info "Reconnecting to \"$vpn_host\" (MFA may be required)…"
  "$_CISCO_VPN_BIN" connect "$vpn_host"
}

# Restart the Cisco Secure Client UI, which reloads its network socket filter.
vpn:reset-filter() {
  log info "Restarting Cisco Secure Client UI (resetting socket filter)…"
  killall "Cisco Secure Client" 2>/dev/null || true
  sleep 2
  open -a "Cisco Secure Client"
}

# Export every proxy variable the toolchain reads, and mirror the main ones
# into the launchd session so GUI apps see them too. Omitted arguments fall
# back to PROXY_PROTOCOL, PROXY_HOST, PROXY_PORT, and NO_PROXY from .exports,
# and the first three have to resolve to a value one way or the other.
# Usage: proxy:set <protocol> <host> <port> [no_proxy]
proxy:set() {
  local proxy_protocol="${1:-${PROXY_PROTOCOL}}"
  local proxy_host="${2:-${PROXY_HOST}}"
  local proxy_port="${3:-${PROXY_PORT}}"
  local no_proxy="${4:-${NO_PROXY}}"

  if [[ -z "${proxy_protocol}" || -z "${proxy_host}" || -z "${proxy_port}" ]]; then
    echo "Usage: proxy:set <protocol> <host> <port> [no_proxy]" >&2
    echo "Or set PROXY_PROTOCOL, PROXY_HOST, and PROXY_PORT in ${HOME}/.exports" >&2
    return 1
  fi

  local proxy_addr="${proxy_protocol}://${proxy_host}:${proxy_port}"

  export http_proxy="${proxy_addr}"
  export https_proxy="${proxy_addr}"
  export ftp_proxy="${proxy_addr}"
  export all_proxy="${proxy_addr}"
  export HTTP_PROXY="${proxy_addr}"
  export HTTPS_PROXY="${proxy_addr}"
  export FTP_PROXY="${proxy_addr}"
  export ALL_PROXY="${proxy_addr}"
  export PIP_PROXY="${proxy_addr}"
  export no_proxy="${no_proxy}"
  export NO_PROXY="${no_proxy}"
  export MAVEN_OPTS="-Dhttp.proxyHost=${proxy_host} -Dhttp.proxyPort=${proxy_port} -Dhttps.proxyHost=${proxy_host} -Dhttps.proxyPort=${proxy_port}"

  launchctl setenv HTTP_PROXY "${proxy_addr}" 2>/dev/null
  launchctl setenv HTTPS_PROXY "${proxy_addr}" 2>/dev/null
  launchctl setenv ALL_PROXY "${proxy_addr}" 2>/dev/null
  launchctl setenv NO_PROXY "${no_proxy}" 2>/dev/null

  # npm has no per-proxy registry setting, so .npmrc reads the active host from
  # the environment. Only work machines define these, so this is a no-op elsewhere.
  if [[ -n "${NPM_SWISSCOM_REGISTRY_PROXIED:-}" ]]; then
    export NPM_SWISSCOM_REGISTRY="${NPM_SWISSCOM_REGISTRY_PROXIED}"
    launchctl setenv NPM_SWISSCOM_REGISTRY "${NPM_SWISSCOM_REGISTRY_PROXIED}" 2>/dev/null
  fi
}

# Clear everything proxy:set exported, in the shell and in the launchd session.
proxy:unset() {
  local var
  for var in http_proxy https_proxy ftp_proxy all_proxy \
             HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY \
             PIP_PROXY no_proxy NO_PROXY MAVEN_OPTS; do
    unset "$var"
  done

  for var in HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY; do
    launchctl unsetenv "$var" 2>/dev/null
  done

  # Swap the npm scope back to the direct host rather than unsetting it, because
  # .npmrc has no fallback and would render the variable name literally.
  if [[ -n "${NPM_SWISSCOM_REGISTRY_DIRECT:-}" ]]; then
    export NPM_SWISSCOM_REGISTRY="${NPM_SWISSCOM_REGISTRY_DIRECT}"
    launchctl setenv NPM_SWISSCOM_REGISTRY "${NPM_SWISSCOM_REGISTRY_DIRECT}" 2>/dev/null
  fi
}

# Turn the proxy on or off depending on whether the corporate proxy answers.
# Pass the literal keyword "dns" to switch the DNS servers to match.
# Usage: proxy:probe ["dns"]
proxy:probe() {
  local with_dns="${1:-}"

  if nc -z -w 3 "${PROXY_HOST}" "${PROXY_PORT}" &>/dev/null; then
    log info "Enabling proxy (corporate network detected)…"
    proxy:set "${PROXY_PROTOCOL}" "${PROXY_HOST}" "${PROXY_PORT}" "${NO_PROXY}"

    if [[ "${with_dns}" == "dns" ]]; then
      if [[ -n "${PROXY_NETWORK_SERVICE}" && -n "${PROXY_DNS}" ]]; then
        dns:change "${PROXY_NETWORK_SERVICE}" "${PROXY_DNS}"
      else
        log warning "Skipped DNS change (PROXY_NETWORK_SERVICE or PROXY_DNS not set)"
      fi
    fi
  else
    log info "Disabling proxy (no corporate network detected)…"
    proxy:unset

    if [[ "${with_dns}" == "dns" ]]; then
      if [[ -n "${PROXY_NETWORK_SERVICE}" && -n "${NO_PROXY_DNS}" ]]; then
        dns:change "${PROXY_NETWORK_SERVICE}" "${NO_PROXY_DNS}"
      else
        log warning "Skipped DNS change (PROXY_NETWORK_SERVICE or NO_PROXY_DNS not set)"
      fi
    fi
  fi
}

# Reload the proxy-watchd LaunchAgent so plist changes take effect.
proxyd:reload() {
  local label="local.proxy-watchd"
  local plist="${HOME}/Library/LaunchAgents/${label}.plist"

  [[ -f "${plist}" ]] || { log error "Failed to find plist (${plist})"; return 1; }

  launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "${plist}" \
    || { log error "Failed to bootstrap ${label} (check the plist and retry)"; return 1; }
  log success "Reloaded ${label}"
}

# Show whether proxy-watchd is loaded, when it last switched, and the proxy
# variables currently in effect.
proxyd:status() {
  local label="local.proxy-watchd"
  local state_file="${HOME}/.cache/proxy-state"

  if launchctl print "gui/$(id -u)/${label}" &>/dev/null; then
    echo "Agent:  loaded (trigger-based, runs on network change)"
  else
    log warning "Found no loaded agent"
  fi

  if [[ -f "${state_file}" ]]; then
    echo "Proxy:  $(< "${state_file}") (since $(stat -f '%Sm' "${state_file}"))"
  else
    log warning "Found no state file"
  fi

  local _v
  echo ""
  echo "  Active (toggled by proxy:set/proxy:unset):"
  for _v in HTTP_PROXY HTTPS_PROXY ALL_PROXY FTP_PROXY PIP_PROXY NO_PROXY MAVEN_OPTS NPM_SWISSCOM_REGISTRY; do
    printf "    %-15s %s\n" "${_v}" "${(P)_v:-<unset>}"
  done

  echo ""
  echo "  Configuration (static, set by chezmoi):"
  for _v in NTLM_CREDENTIALS NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED NODE_USE_ENV_PROXY SSL_BUNDLE_KEYCHAIN_CERTS SSL_BUNDLE_REMOTE_CERTS; do
    printf "    %-30s %s\n" "${_v}" "${(P)_v:-<unset>}"
  done
}

# Show proxy-watchd entries from the unified log (default last 5 minutes).
# Usage: proxyd:log [duration]
proxyd:log() {
  /usr/bin/log show --predicate 'eventMessage CONTAINS "proxy-watchd"' --last "${1:-5m}"
}

# Repair the broken Drive TLS state, trying the cheapest fix first.
network:heal() {
  if vpn:google-broken; then
    log warning "Detected broken Drive TLS state, trying soft Cisco refresh"
    vpn:soft-refresh || {
      log warning "Failed to soft-refresh Drive, trying Cisco UI restart"
      vpn:reset-filter
      sleep 3

      if vpn:google-broken; then
        log warning "Failed to recover Drive (still broken after UI restart, run 'vpn:refresh' manually)"
        return 1
      fi

      log success "Verified Drive works after Cisco UI restart"
    }
  fi
}

# ------------------------------------ SSH ----------------------------------- #

# Adopt a forwarded ssh-agent socket left behind in /tmp by an earlier session.
ssh:reagent() {
  local agent
  for agent in /tmp/ssh-*/agent.*; do
    export SSH_AUTH_SOCK="${agent}"
    if ssh-add -l &>/dev/null; then
      log success "Found working SSH agent"
      ssh-add -l
      return 0
    fi
  done
  log warning "Found no working SSH agent (reconnect with forwarding)"
  return 1
}

# Point SSH_AUTH_SOCK at a working agent, starting a fresh one if needed.
ssh:agent() {
  if pgrep -x ssh-agent &>/dev/null; then
    ssh:reagent &>/dev/null || eval "$(ssh-agent)" &>/dev/null
  else
    eval "$(ssh-agent)" &>/dev/null
  fi
}

# --------------------------------- Secrets ---------------------------------- #
#
# A dedicated `dotfiles` keychain (separate from `login`) is the source of truth
# for every managed secret. The tokens file on iCloud Drive
# (`$SECRETS_TOKENS_FILE`) mirrors it as a tab-separated backup, so a fresh
# machine can re-import everything in one shot.
# Tokens-file format: id<TAB>account<TAB>where<TAB>kind<TAB>comment<TAB>password
#
# Every read of that format below uses IFS=$'\t\t', and the doubled tab is
# load-bearing. zsh treats an IFS whitespace character that appears twice as a
# plain separator (zshparam(1), IFS), so runs of tabs stop collapsing and empty
# where, kind, and comment fields survive the read. A single $'\t' would shift
# every field after an empty one.
#
# Five metadata fields map to native macOS keychain attributes (the password is
# the stored value, not an attribute):
#   id      = friendly name, populates the Label (-l), and is the lookup key
#             when SECRETS_KEYCHAIN_LOOKUP_FIELD is "name" (the default)
#   account = identity (-a)
#   where   = provider URL, populates the Service (-s). macOS enforces
#             (Service, Account) uniqueness at the storage layer
#   kind    = secret type, populates the "desc" attribute (-D)
#   comment = what reads this secret, populates "icmt" (-j)
#
# Every entry is created with `-A` so chezmoi templates can read it at apply
# time without a per-app keychain confirmation prompt.
#
# Naming: secret:* acts on a single entry, secrets:* acts on the whole set
# (list, import, export).
#
# ---------------------------------------------------------------------------- #

_SECRETS_TOKENS_FILE="${SECRETS_TOKENS_FILE}"
_SECRETS_KEYCHAIN="$HOME/Library/Keychains/${SECRETS_KEYCHAIN_NAME:-dotfiles}.keychain-db"

# Map the configured lookup field to the matching `security` flag.
typeset -gA _SECRETS_FLAG_MAP=(name -l where -s kind -D comment -j)
_SECRETS_LOOKUP_FLAG="${_SECRETS_FLAG_MAP[${SECRETS_KEYCHAIN_LOOKUP_FIELD:-name}]:--l}"

# Create the managed keychain if it is missing, and add it to the user search
# list. An empty SECRETS_KEYCHAIN_PASSWORD makes the keychain inherit the login
# session unlock state, so nothing extra is prompted for during use. A non-empty
# value sets a master password that has to be entered to unlock.
_secrets:ensure-keychain() {
  if [[ ! -f "$_SECRETS_KEYCHAIN" ]]; then
    local pw="${SECRETS_KEYCHAIN_PASSWORD:-}"
    security create-keychain -p "$pw" "${_SECRETS_KEYCHAIN%-db}" >/dev/null
    # Lock on system sleep, no idle timeout, see run_before_00-unlock-keychain.
    security set-keychain-settings -l "$_SECRETS_KEYCHAIN"
    security unlock-keychain -p "$pw" "$_SECRETS_KEYCHAIN"
  fi
  if ! security list-keychains -d user 2>/dev/null | grep -qF -- "$_SECRETS_KEYCHAIN"; then
    local -a paths=( ${(@f)"$(security list-keychains -d user | tr -d '"' | xargs -n1)"} )
    security list-keychains -d user -s "$_SECRETS_KEYCHAIN" "${paths[@]}"
  fi
}

_secrets:write-header() {
  printf '# id\taccount\twhere\tkind\tcomment\tpassword\n# Managed by secrets:export. Run secrets:import on new machines to load into the keychain\n' > "$1"
}

# Ensure the tokens file exists with a header and user-only permissions.
# Idempotent, so re-running fixes either problem without touching the content.
_secrets:ensure-tokens-file() {
  [[ -d "${_SECRETS_TOKENS_FILE:h}" ]] || mkdir -p "${_SECRETS_TOKENS_FILE:h}"
  [[ -f "$_SECRETS_TOKENS_FILE" ]] || _secrets:write-header "$_SECRETS_TOKENS_FILE"
  chmod 600 "$_SECRETS_TOKENS_FILE"
}

# Stream "id<TAB>account<TAB>where<TAB>kind<TAB>comment" for every generic
# password entry in the keychain (the source of truth), sorted by id. Reads
# metadata from `security dump-keychain`, which never emits password data.
# Missing attributes render empty. dump-keychain hex-encodes any value holding
# non-ASCII bytes, which awk decodes back (LC_ALL=C keeps sprintf("%c") byte
# oriented).
_secrets:entries() {
  [[ -f "$_SECRETS_KEYCHAIN" ]] || return 0
  security dump-keychain "$_SECRETS_KEYCHAIN" 2>/dev/null | LC_ALL=C awk '
    function hx(c) { return index("0123456789abcdef", c) - 1 }
    function hexdec(h,   i, out) {
      h = tolower(h); out = ""
      for (i = 1; i < length(h); i += 2)
        out = out sprintf("%c", hx(substr(h, i, 1)) * 16 + hx(substr(h, i + 1, 1)))
      return out
    }
    function val(line) {
      if (line ~ /<blob>="/) {                   # printable value, quoted
        sub(/^[^=]*="/, "", line); sub(/"$/, "", line); return line
      }
      if (line ~ /<blob>=0x/) {                  # non-ASCII value, hex-encoded
        sub(/^[^=]*=0x/, "", line); sub(/[[:space:]].*$/, "", line)
        return hexdec(line)
      }
      return ""                                  # <NULL>
    }
    function flush() {
      if (cls == "\"genp\"" && (id != "" || acct != ""))
        print id "\t" acct "\t" where "\t" kind "\t" comment
    }
    /^keychain:/            { flush(); cls = id = acct = where = kind = comment = "" }
    /^class:/               { cls = $2 }
    /^ *0x00000007 <blob>=/ { id      = val($0) }   # 0x00000007 = Label (-l)
    /^ *"acct"<blob>=/      { acct    = val($0) }
    /^ *"svce"<blob>=/      { where   = val($0) }
    /^ *"desc"<blob>=/      { kind    = val($0) }
    /^ *"icmt"<blob>=/      { comment = val($0) }
    END                     { flush() }
  ' | LC_ALL=C sort -f
}

# Read the Where, Kind, and Comments attributes of a managed secret. Emits one
# tab-separated line "<where>\t<kind>\t<comment>". Missing fields render empty.
# Exits non-zero if the entry is absent. Reuses the _secrets:entries parser,
# which is the only one that also decodes the hex form `security` prints for
# any value holding non-ASCII bytes. Matches on the configured lookup field, so
# it stays in step with _secrets:password rather than always keying on the Label.
# Usage: _secrets:attrs <id> <account>
_secrets:attrs() {
  local id acct where kind comment key
  while IFS=$'\t\t' read -r id acct where kind comment; do
    case "${SECRETS_KEYCHAIN_LOOKUP_FIELD:-name}" in
      where)   key="$where" ;;
      kind)    key="$kind" ;;
      comment) key="$comment" ;;
      *)       key="$id" ;;
    esac
    [[ "$key" == "$1" && "$acct" == "$2" ]] || continue
    print -r -- "${where}"$'\t'"${kind}"$'\t'"${comment}"
    return 0
  done < <(_secrets:entries)
  return 1
}

# Print the password of a managed secret. Prints nothing and exits non-zero
# when the entry is missing.
# Usage: _secrets:password <id> <account>
_secrets:password() {
  security find-generic-password "$_SECRETS_LOOKUP_FLAG" "$1" -a "$2" -w "$_SECRETS_KEYCHAIN" 2>/dev/null
}

# Write a secret to the dotfiles keychain, adding it or updating it in place.
# Usage: _secrets:install <id> <account> <where> <kind> <password> [comment]
_secrets:install() {
  local id="$1" acct="$2" where="$3" kind="$4" password="$5" comment="${6:-}"
  _secrets:ensure-keychain
  local -a flags=(-U -A -s "$where" -a "$acct" -l "$id" -D "$kind" -w "$password" "$_SECRETS_KEYCHAIN")
  [[ -n "$comment" ]] && flags=( -j "$comment" "${flags[@]}" )
  if ! security add-generic-password "${flags[@]}"; then
    log error "Failed to update keychain"
    return 1
  fi
}

# Add a secret to the dotfiles keychain, then sync to iCloud Drive. The password
# is read interactively, so it is never echoed or stored in shell history.
# Refuses to create a duplicate (id, account) pair, which macOS does not enforce
# itself, and refuses a (where, account) pair another entry already owns, since
# `add-generic-password -U` matches on that pair and would overwrite the entry
# holding it, password included.
# Usage: secret:set <id> <account> <where> <kind> [comment]
secret:set() {
  (( $# >= 4 && $# <= 5 )) || { echo "Usage: secret:set <id> <account> <where> <kind> [comment]" >&2; return 1; }
  local id="$1" account="$2" where="$3" kind="$4" comment="${5:-}" password

  if _secrets:password "$id" "$account" >/dev/null 2>&1; then
    log error "Rejected $id / $account (already exists, run secret:remove first to replace the value)"
    return 1
  fi

  if security find-generic-password -s "$where" -a "$account" "$_SECRETS_KEYCHAIN" >/dev/null 2>&1; then
    log error "Rejected $id / $account (another entry already holds this where and account, run secrets:list to find it)"
    return 1
  fi

  printf "Password for %s/%s: " "$id" "$account"
  read -rs password
  echo
  [[ -n "$password" ]] || { log error "Canceled (password cannot be empty)"; return 1; }

  _secrets:install "$id" "$account" "$where" "$kind" "$password" "$comment" || return 1
  log success "Added $id / $account ($kind)"
  secrets:export
}

# Read a secret from the dotfiles keychain.
# Usage: secret:get <id> <account>
secret:get() {
  (( $# == 2 )) || { echo "Usage: secret:get <id> <account>" >&2; return 1; }
  _secrets:password "$1" "$2" || { log error "Failed to find $1 / $2"; return 1; }
}

# Copy a secret to the clipboard, then clear it after SECRETS_CLIPBOARD_TTL
# seconds (default 30). The clipboard is only cleared if it still holds the same
# value, so anything copied in the meantime survives.
# Usage: secret:copy <id> <account>
secret:copy() {
  (( $# == 2 )) || { echo "Usage: secret:copy <id> <account>" >&2; return 1; }
  local password snapshot ttl="${SECRETS_CLIPBOARD_TTL:-30}"

  password="$(_secrets:password "$1" "$2")" \
    || { log error "Failed to find $1 / $2"; return 1; }

  printf '%s' "$password" | pbcopy \
    || { log error "Failed to copy $1 / $2 to the clipboard"; return 1; }
  snapshot=$(printf '%s' "$password" | shasum -a 256 | awk '{print $1}')
  unset password

  ( sleep "$ttl"
    [[ "$(pbpaste 2>/dev/null | shasum -a 256 | awk '{print $1}')" == "$snapshot" ]] \
      && printf '' | pbcopy
  ) &!

  log success "Copied $1 / $2 to clipboard (auto-clears in ${ttl}s)"
}

# Remove a secret from the dotfiles keychain, then sync to iCloud Drive.
# Usage: secret:remove <id> <account>
secret:remove() {
  (( $# == 2 )) || { echo "Usage: secret:remove <id> <account>" >&2; return 1; }
  if security delete-generic-password "$_SECRETS_LOOKUP_FLAG" "$1" -a "$2" "$_SECRETS_KEYCHAIN" >/dev/null 2>&1; then
    log success "Removed $1 / $2"
  else
    log warning "Skipped $1 / $2 (not in keychain)"
  fi
  secrets:export
}

# Rename a managed secret and optionally update its metadata. The source must
# exist and the target (when different) must not, which prevents silent
# overwrites. Omit where, kind, or comment to keep the current value.
# Usage: secret:rename <old_id> <old_account> <new_id> <new_account> [new_where] [new_kind] [new_comment]
secret:rename() {
  (( $# >= 4 && $# <= 7 )) || {
    echo "Usage: secret:rename <old_id> <old_account> <new_id> <new_account> [new_where] [new_kind] [new_comment]" >&2
    return 1
  }
  local old_id="$1" old_acct="$2" new_id="$3" new_acct="$4" password new_where new_kind new_comment
  # Two different notions of "same entry" are in play. same_lookup answers
  # "would the target collide with a different entry under the lookup field",
  # while same_storage answers "does add-generic-password -U update this item
  # in place", which macOS decides from (Service, Account) alone.
  local same_lookup=0
  [[ "$old_id" == "$new_id" && "$old_acct" == "$new_acct" ]] && same_lookup=1

  password="$(_secrets:password "$old_id" "$old_acct")" \
    || { log error "Failed to find $old_id / $old_acct"; return 1; }

  if (( ! same_lookup )) && _secrets:password "$new_id" "$new_acct" >/dev/null; then
    log error "Rejected $new_id / $new_acct (target already exists)"
    return 1
  fi

  local cur_where cur_kind cur_comment
  IFS=$'\t\t' read -r cur_where cur_kind cur_comment < <(_secrets:attrs "$old_id" "$old_acct")
  new_where="${5:-$cur_where}"
  new_kind="${6:-$cur_kind}"
  new_comment="${7:-$cur_comment}"

  local same_storage=0
  [[ "$new_where" == "$cur_where" && "$new_acct" == "$old_acct" ]] && same_storage=1

  # Writing a (Service, Account) pair that belongs to another entry would
  # replace that entry instead of moving this one.
  if (( ! same_storage )) \
    && security find-generic-password -s "$new_where" -a "$new_acct" "$_SECRETS_KEYCHAIN" >/dev/null 2>&1; then
    log error "Rejected $new_id / $new_acct (another entry already holds this where and account, run secrets:list to find it)"
    return 1
  fi

  _secrets:install "$new_id" "$new_acct" "$new_where" "$new_kind" "$password" "$new_comment" || return 1
  # Only a changed storage pair leaves the original item behind, and it is
  # addressed by that pair, because the new item may now share the old Label.
  if (( ! same_storage )) \
    && ! security delete-generic-password -s "$cur_where" -a "$old_acct" "$_SECRETS_KEYCHAIN" >/dev/null 2>&1; then
    log warning "Skipped removing $old_id / $old_acct (copy left behind, remove it with secret:remove)"
  fi

  log success "Renamed $old_id / $old_acct → $new_id / $new_acct ($new_kind)"
  secrets:export
}

# List managed secrets as a sorted table (ID, Account, Kind, Used by, Where).
# Reads the keychain directly (one `security` call in total), so entries added
# outside secret:set show up too.
secrets:list() {
  if [[ ! -f "$_SECRETS_KEYCHAIN" ]]; then
    log warning "Failed to find keychain ($_SECRETS_KEYCHAIN)"
    return 1
  fi

  {
    print -r -- $'ID\tACCOUNT\tKIND\tUSED BY\tWHERE'
    local id account where kind comment
    while IFS=$'\t\t' read -r id account where kind comment; do
      print -r -- "$id"$'\t'"$account"$'\t'"${kind:-(none)}"$'\t'"${comment:-(none)}"$'\t'"${where:-(none)}"
    done < <(_secrets:entries)
  } | column -t -s $'\t'
}

# Sync tokens-file entries into the keychain and report the status of each one.
# The keychain stays the source of truth. Entries it lacks are imported from the
# file (for example after an iCloud sync from another machine), while stale file
# passwords (drift or placeholder) are left for secrets:export to overwrite.
# A password of the literal string "placeholder" is a stub row from older tokens
# files (secret:set used to append one). It is reported, never imported. Restore
# the real value with secret:set, or drop the row by running secrets:export.
# A "conflict" row is one whose Where and Account already belong to a different
# keychain entry. It is reported, never imported, because writing it would
# replace that entry. Run secrets:list to find the owner.
# Exits non-zero while any entry still needs attention.
secrets:import() {
  if [[ ! -f "$_SECRETS_TOKENS_FILE" ]]; then
    log warning "Failed to find tokens file ($_SECRETS_TOKENS_FILE)"
    return 1
  fi

  local id acct where kind comment file_pw kc_pw state total=0 drift=0 imported=0 rc
  local -a rows

  while IFS=$'\t\t' read -r id acct where kind comment file_pw; do
    [[ -z "$id" || "$id" == \#* ]] && continue
    (( ++total ))
    kc_pw="$(_secrets:password "$id" "$acct")"; rc=$?
    if (( rc == 44 )); then    # errSecItemNotFound, the entry is definitively absent
      if [[ -z "$file_pw" || "$file_pw" == placeholder ]]; then
        state="missing"; (( ++drift ))
      # Absent under the lookup field is not the same as absent in storage.
      # macOS keys generic passwords by (Service, Account), so importing a row
      # whose pair another entry already owns would overwrite that entry.
      elif security find-generic-password -s "$where" -a "$acct" "$_SECRETS_KEYCHAIN" >/dev/null 2>&1; then
        state="conflict"; (( ++drift ))
      elif _secrets:install "$id" "$acct" "$where" "$kind" "$file_pw" "$comment"; then
        state="imported"; (( ++imported ))
      else
        state="failed"; (( ++drift ))
      fi
    elif (( rc != 0 )); then   # locked keychain or denied read, never write blind
      state="failed"; (( ++drift ))
    elif [[ "$file_pw" == placeholder ]]; then
      state="placeholder"; (( ++drift ))
    elif [[ "$file_pw" != "$kc_pw" ]]; then
      state="drift";       (( ++drift ))
    else
      state="ok"
    fi
    rows+=("$state"$'\t'"$id"$'\t'"$acct")
  done < "$_SECRETS_TOKENS_FILE"

  {
    print -r -- $'STATUS\tID\tACCOUNT'
    print -lr -- "${rows[@]}" | LC_ALL=C sort
  } | column -t -s $'\t'

  (( imported > 0 )) && log success "Imported $imported secret(s) into the keychain"
  if (( drift > 0 )); then
    log warning "Detected drift in $drift / $total entries (run secrets:export to sync, or secret:set to restore missing ones)"
    return 1
  fi
  log success "Synced $total / $total entries"
}

# Read the password a previous export recorded for an entry. Lets secrets:export
# carry a value forward when the keychain read fails, instead of dropping the
# row. Exits non-zero when the file holds no row for the pair.
# Usage: _secrets:backed-up-password <id> <account>
_secrets:backed-up-password() {
  [[ -f "$_SECRETS_TOKENS_FILE" ]] || return 1
  local f_id f_acct f_where f_kind f_comment f_pw
  while IFS=$'\t\t' read -r f_id f_acct f_where f_kind f_comment f_pw; do
    [[ -z "$f_id" || "$f_id" == \#* ]] && continue
    if [[ "$f_id" == "$1" && "$f_acct" == "$2" ]]; then
      print -r -- "$f_pw"
      return 0
    fi
  done < "$_SECRETS_TOKENS_FILE"
  return 1
}

# Summarise the entries secrets:export could not read, keeping the two outcomes
# apart. A carried-over entry still has its value in the backup, a dropped one
# does not, so reporting them under one heading would make real loss look
# temporary. The status stays zero either way, because secrets:export is the
# tail call of secret:set, secret:remove and secret:rename, and one unreadable
# entry must not make an otherwise successful command report failure.
# Usage: _secrets:report-unread <kept> <dropped>
_secrets:report-unread() {
  (( $1 )) && log warning "Carried $1 entry(s) over from the previous backup (failed to read them)"
  (( $2 )) && log error "Dropped $2 entry(s) from the backup (failed to read, with no backed-up value to keep)"
  return 0
}

# Atomically rewrite the iCloud tokens file from the current keychain values.
# Reads the keychain itself (the source of truth), so entries added outside
# secret:set are exported too. File entries that have vanished from the keychain
# are dropped with a warning. The write is skipped when nothing changed, so
# iCloud only re-uploads on a real update.
secrets:export() {
  _secrets:ensure-tokens-file

  local tmp id account where kind comment password prior count=0 kept=0 dropped=0
  tmp="$(mktemp)"
  trap "command rm -f ${(q)tmp}" EXIT

  _secrets:write-header "$tmp"
  while IFS=$'\t\t' read -r id account where kind comment; do
    # (Service, Account) is unique at the storage layer, so this hits exactly
    # the enumerated entry regardless of the configured lookup field.
    if password="$(security find-generic-password -s "$where" -a "$account" -w "$_SECRETS_KEYCHAIN" 2>/dev/null)"; then
      print -r -- "${id}"$'\t'"${account}"$'\t'"${where}"$'\t'"${kind}"$'\t'"${comment}"$'\t'"${password}" >> "$tmp"
      (( ++count ))
    # A read can fail for one entry alone (an item added outside secret:set has
    # no -A ACL, so `security` prompts and a denial fails just that read). Carry
    # the previous backup value forward rather than dropping the row for good.
    # Metadata still comes from the keychain, so edits keep propagating.
    elif prior="$(_secrets:backed-up-password "$id" "$account")" && [[ -n "$prior" ]]; then
      print -r -- "${id}"$'\t'"${account}"$'\t'"${where}"$'\t'"${kind}"$'\t'"${comment}"$'\t'"${prior}" >> "$tmp"
      (( ++kept ))
      log warning "Kept the backed-up value for $id / $account (failed to read password)"
    else
      (( ++dropped ))
      log error "Dropped $id / $account from the backup (failed to read password, no backed-up value to keep)"
    fi
  done < <(_secrets:entries)

  # Refuse to clobber a populated backup from an empty keychain (e.g. a fresh
  # machine whose iCloud backup synced down after bootstrap already ran).
  if (( count == 0 )) && grep -qvE '^[[:space:]]*#|^[[:space:]]*$' "$_SECRETS_TOKENS_FILE"; then
    command rm -f "$tmp"
    trap - EXIT
    log error "Refused to overwrite populated tokens file from an empty keychain (run secrets:import first)"
    return 1
  fi

  while IFS=$'\t\t' read -r id account; do
    [[ -n "$id" ]] && log warning "Dropped $id / $account (no longer in keychain)"
  done < <(comm -23 \
    <(awk -F'\t' '!/^[[:space:]]*#/ && NF>=2 {print $1 "\t" $2}' "$_SECRETS_TOKENS_FILE" | sort) \
    <(awk -F'\t' '!/^[[:space:]]*#/ && NF>=2 {print $1 "\t" $2}' "$tmp" | sort))

  if cmp -s "$tmp" "$_SECRETS_TOKENS_FILE"; then
    command rm -f "$tmp"
    trap - EXIT
    _secrets:report-unread "$kept" "$dropped"
    log success "Verified $count secret(s) already in sync"
    return 0
  fi

  mv "$tmp" "$_SECRETS_TOKENS_FILE"
  trap - EXIT
  _secrets:report-unread "$kept" "$dropped"
  log success "Exported $count secret(s) to iCloud Drive"
}

# ----------------------- macOS System Tweaks & Utilities -------------------- #

# Let Touch ID authenticate sudo by adding pam_tid to /etc/pam.d/sudo.
# Backs the file up first and restores it if any step fails.
sudo:touch-id() {
  local FILE='/etc/pam.d/sudo'
  local BACKUP
  BACKUP="$(mktemp /tmp/sudo.pam.backup.XXXXXX)"

  trap "command rm -f ${(q)BACKUP}" EXIT

  log info "Backing up ${FILE} → ${BACKUP}…"
  sudo cp "$FILE" "$BACKUP" || { log error "Failed to create backup"; return 1; }

  # Only enable restore-on-error after a valid backup exists
  trap 'trap - ERR; log error "Detected an error, restoring the original file"; sudo cp "$BACKUP" "$FILE"; return 1' ERR

  if ! sudo grep -q '^# sudo: auth account password session' "$FILE"; then
    log error "Failed to find required marker comment in $FILE"
    return 1
  fi

  if ! sudo grep -qF 'auth       sufficient     pam_tid.so' "$FILE"; then
    log info "Inserting pam_tid line into ${FILE}…"
    sudo sed -i '' '/^# sudo: auth account password session/a\
auth       sufficient     pam_tid.so
' "$FILE"
  else
    log info "Skipped pam_tid line (already present)"
  fi

  trap - ERR
  log success "Updated $FILE"
}

gatekeeper:disable() {
  sudo spctl --master-disable
}

gatekeeper:enable() {
  sudo spctl --master-enable
}

hostname:get() {
  scutil --get ComputerName
}

# Set the computer, host, and local host names in one go.
# Usage: hostname:set <new_hostname>
hostname:set() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: hostname:set <new_hostname>" >&2
    return 1
  fi

  local new_hostname="$1"

  sudo scutil --set ComputerName "$new_hostname" \
    && sudo scutil --set HostName "$new_hostname" \
    && sudo scutil --set LocalHostName "$new_hostname" \
    || { log error "Failed to set hostname \"$new_hostname\""; return 1; }

  log success "Set hostname \"$new_hostname\" (restart may be required)"
}

hostname:reset() {
  hostname:set "${DEFAULT_HOSTNAME}"
}

# Rebuild the Dock from scratch with only the apps listed in DOCK_APPS.
dock:reset() {
  defaults delete com.apple.dock
  killall Dock
  sleep 5

  local -a apps
  IFS=',' read -rA apps <<< "${DOCK_APPS:-}"
  local app
  for app in "${apps[@]}"; do
    app="$(printf '%s' "$app" | xargs)"
    [[ -z "$app" ]] && continue
    defaults write com.apple.dock persistent-apps -array-add "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>/Applications/${app}.app</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>"
  done

  defaults write com.apple.dock mineffect -string "scale"
  defaults write com.apple.dock minimize-to-application -bool true
  defaults write com.apple.dock launchanim -bool false
  defaults write com.apple.dock show-recents -bool false
  defaults write com.apple.dock expose-group-apps -bool true

  killall Dock
}

system:setup() {
  gatekeeper:disable
  hostname:reset
  sudo:touch-id
}

system:shutdown() {
  sudo shutdown -h now
}

system:restart() {
  sudo shutdown -r now
}

system:sleep() {
  sudo shutdown -s now
}

# ---------------------------------- Docker ---------------------------------- #

# Best-effort bulk docker subcommand. Empty input is a no-op, and failures are
# swallowed on purpose, since stop, rm, and rmi often race against each other.
# Usage: _docker:bulk <subcommand> <ids>
_docker:bulk() {
  local cmd="$1" ids="$2"
  [[ -n "$ids" ]] || return 0
  print -r -- "$ids" | xargs docker "$cmd" 2>/dev/null || true
}

# Remove every container and image, stopping the containers first. Anything
# whose ID, container name, or image repository matches keep_pattern is kept.
# Pass a single extended regular expression, because extra arguments are joined
# with a space into one pattern rather than treated as alternatives.
# Usage: docker:cleanup [keep_pattern]
docker:cleanup() {
  docker info &>/dev/null || {
    log error "Failed to reach the Docker daemon (start Docker Desktop and retry)"
    return 1
  }

  local containers images
  if (( $# == 0 )); then
    containers="$(docker ps -aq 2>/dev/null)"   || true
    images="$(docker images -q 2>/dev/null)"    || true
  else
    local exclude="$*"
    containers="$(docker ps -a --format '{{.ID}} {{.Names}}'      2>/dev/null | grep -vE "($exclude)" | awk '{print $1}')" || true
    images="$(docker images   --format '{{.ID}} {{.Repository}}'  2>/dev/null | grep -vE "($exclude)" | awk '{print $1}')" || true
  fi
  _docker:bulk stop "$containers"
  _docker:bulk rm   "$containers"
  _docker:bulk rmi  "$images"
}

# -------------------------------- Toolchain --------------------------------- #

# Activate the conda env named in ./environment.yml on entering a directory,
# and deactivate again on leaving.
conda:load() {
  if [[ -f "environment.yml" ]]; then
    local env_name
    env_name=$(grep '^name:' environment.yml | sed 's/^name:[[:space:]]*//')

    if [[ -n "$env_name" && "$CONDA_DEFAULT_ENV" != "$env_name" ]]; then
      conda activate "$env_name" 2>/dev/null || true
    fi
  elif [[ -n "$CONDA_DEFAULT_ENV" && "$CONDA_DEFAULT_ENV" != "base" ]]; then
    conda deactivate
  fi
}

# Refresh every mise-managed tool within the ranges pinned in
# ~/.config/mise/config.toml. Deliberately not `mise upgrade --bump`, which
# would rewrite that file. It is chezmoi-tracked, so version changes belong in
# the source. mise itself is upgraded by Homebrew, never from here.
#
# Scoped to $HOME with -C, like run_onchange_after_06-install-mise-tools. This
# fires unattended from run:daily, in whatever directory the shell started in,
# and mise reads [tools] from the working directory upward. Unscoped, opening
# the first terminal of the day in a project checkout would install that
# project's whole toolchain as a side effect.
mise:update() {
  local output
  local -a lines

  if ! output=$(mise -C "$HOME" upgrade 2>&1 </dev/null); then
    log warning "Failed to update mise-managed tools"
    print -r -- "$output" >&2
    # Return 0 so run:daily still stamps the day. An offline laptop then
    # retries tomorrow rather than on every new shell.
    return 0
  fi

  # Quiet on the common no-op, but drop only that line. mise prints warnings
  # alongside it (a release held back by minimum_release_age, a version list it
  # could not fetch), and matching the whole output would swallow them.
  lines=( ${(f)output} )
  lines=( ${lines:#*"All tools are up to date"*} )
  (( ${#lines} )) && print -rl -- "${lines[@]}"

  # Not redundant. The `&&` above leaves status 1 whenever there is nothing to
  # print, which is the common no-op path, and run:daily only stamps on success.
  return 0
}

# Report deprecated and outdated Homebrew packages without changing anything.
brew:check() {
  local deprecated outdated

  deprecated=$(brew info --installed --json=v2 2>/dev/null \
    | jq -r '(.formulae[], .casks[]) | select(.deprecated or .disabled)
      | "  \(.token // .name) (\(.deprecation_reason // .disable_reason // "unknown"))"' 2>/dev/null)

  [[ -n "$deprecated" ]] && { log warning "Detected deprecated Homebrew packages"; echo "$deprecated"; }

  outdated=$(brew outdated --quiet 2>/dev/null)
  [[ -n "$outdated" ]] || return 0

  local -a outdated_lines=( ${(f)outdated} )
  log info "Detected ${#outdated_lines} outdated Homebrew package(s) (run 'brew upgrade' to update)"
}

# Rewrite this machine's Brewfile from what Homebrew currently has installed.
#
# --no-npm is why this wrapper exists. `brew bundle dump` reads `npm ls -g` from
# the first node on PATH, which under mise is not Homebrew's, so a plain dump
# records mise's global packages as Homebrew's. A later `brew bundle` would then
# install them into whichever node happens to be active.
#
# Runtime formulae stay out of the Brewfile as long as Homebrew has them marked
# as dependencies. If one reappears, it is still flagged as installed on request.
# Clear that with `brew tab --no-installed-on-request <formula>`.
brew:dump() {
  cmd:exists brew || { log error "Failed to find brew"; return 1; }
  cmd:exists chezmoi || { log error "Failed to find chezmoi"; return 1; }

  # Brewfiles are named after the machine type, which chezmoi constrains to
  # personal or work. No mapping is needed, so this cannot drift from the file
  # run_onchange_after_03-brew-packages installs.
  local brewfile
  brewfile="$(chezmoi execute-template '{{ .chezmoi.sourceDir }}/Brewfile.{{ .machine_type }}')" || return 1

  if brew bundle dump --file="$brewfile" --force --no-npm; then
    log success "Dumped Homebrew packages to ${brewfile:t}"
  else
    log error "Failed to dump Homebrew packages"
    return 1
  fi
}

# Record the Zed extensions installed on this machine so a fresh machine can
# restore them. Zed has no CLI to export the list and `brew bundle` covers only
# VS Code and its forks, so the list comes from the index Zed maintains itself.
# dot_config/zed/private_settings.json.tmpl renders it as auto_install_extensions, which
# Zed acts on at startup.
zed:dump() {
  cmd:exists jq || { log error "Failed to find jq"; return 1; }
  cmd:exists chezmoi || { log error "Failed to find chezmoi"; return 1; }

  local index="${HOME}/Library/Application Support/Zed/extensions/index.json"
  [[ -r "$index" ]] || { log error "Failed to read Zed extension index (${index})"; return 1; }

  local source_dir target
  source_dir="$(chezmoi source-path)" || return 1
  target="${source_dir}/.chezmoidata/zed.toml"
  mkdir -p "${target:h}" || return 1

  # Read the list before opening the file. A brace group exits with the status of
  # its last command, so a jq failure inside the redirect below would overwrite a
  # good list with an empty one and still report success.
  local -a entries
  entries=( ${(f)"$(jq -r '.extensions | keys | .[] | "  \"\(.)\","' "$index")"} ) || {
    log error "Failed to parse Zed extension index (${index})"
    return 1
  }

  # Sorted, one per line, so adding an extension is a one-line diff. TOML allows
  # the trailing comma jq leaves on the last entry. The guard is there because
  # `print -rl` on an empty array still emits a blank line.
  {
    print -r -- "# Zed extensions installed on this machine, rendered into"
    print -r -- "# auto_install_extensions by dot_config/zed/private_settings.json.tmpl."
    print -r -- "# Regenerate with zed:dump after installing or removing an extension."
    print -r -- "zed_extensions = ["
    (( ${#entries} )) && print -rl -- "${entries[@]}"
    print -r -- "]"
  } > "$target" || { log error "Failed to write ${target:t}"; return 1; }

  log success "Dumped ${#entries} Zed extension(s) to ${target:t}"
}

# ------------------------------------ Git ----------------------------------- #

# Git-powered colored diff (named gdiff to avoid shadowing /usr/bin/diff)
if cmd:exists git; then
  gdiff() {
    git diff --no-index --color-words "$@"
  }
fi

# Delete a branch locally and on origin.
# Usage: git:delete-branch <branch>
git:delete-branch() {
  if [[ -z "$1" ]]; then
    echo "Usage: git:delete-branch <branch>" >&2
    return 1
  fi
  git branch -d -- "$1" && git push origin :"$1"
}

# Apply a stash by index, leaving it on the stack.
# Usage: gas <stash_index>
gas() {
  if [[ -z "$1" ]]; then
    echo "Usage: gas <stash_index>" >&2
    return 1
  fi
  git stash apply "stash@{$1}"
}

# Interactively rebase the last N commits.
# Usage: git:rebase <commit_count>
git:rebase() {
  if [[ -z "$1" ]]; then
    echo "Usage: git:rebase <commit_count>" >&2
    return 1
  fi
  git rebase -i "HEAD~$1"
}

# Copy the full target-branch content of every file that differs between two
# branches to the clipboard, ready to paste into a review or a chat.
# Usage: git:diff <source_branch> <target_branch> [exclude_pattern]
git:diff() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: git:diff <source_branch> <target_branch> [exclude_pattern]" >&2
    return 1
  fi

  local source_branch="$1"
  local target_branch="$2"
  local exclude_pattern="$3"

  local diff_args=("$source_branch...$target_branch")
  [[ -n "$exclude_pattern" ]] && diff_args+=(-- ":!$exclude_pattern")

  # Collect the file list before writing anything, so a bad revision leaves the
  # clipboard alone instead of clearing it and then reporting the failure.
  local -a files
  files=( ${(f)"$(git diff --name-only "${diff_args[@]}")"} ) || {
    log error "Failed to list changed files (check '${source_branch}' and '${target_branch}' both exist)"
    return 1
  }

  local file
  for file in "${files[@]}"; do
    printf '\n%s:\n\n' "$file"
    git show "$target_branch:$file"
  done | pbcopy

  log success "Copied changed file contents to clipboard"
}

# --------------------------------- Chezmoi ---------------------------------- #

# Clear the stale local state that a new shell or gpg trips over. Drops
# group-write bits from insecure zsh completion directories and removes
# leftover GnuPG lock files.
chezmoi:cleanup() {
  # Silence zsh completion warnings by dropping group-write permissions
  if cmd:exists compaudit; then
    local dirs
    dirs="$(compaudit 2>/dev/null)"
    if [[ -n "$dirs" ]]; then
      echo "$dirs" | xargs chmod g-w 2>/dev/null
      log success "Fixed insecure zsh completion directories"
    fi
  fi

  # Remove stale GnuPG lock files
  local gpg_locks
  gpg_locks=("$HOME"/.gnupg/public-keys.d/pubring.db*.lock(N))
  if (( ${#gpg_locks[@]} )); then
    command rm -f "${gpg_locks[@]}"
    log success "Removed ${#gpg_locks[@]} stale GnuPG lock file(s)"
  fi
}

# Copy template-managed files back into the chezmoi source. Files that only use
# {{ .chezmoi.homeDir }} are synced automatically by substituting it back in.
# Files with secrets or other template variables are flagged for a manual merge.
chezmoi:sync() {
  cmd:exists chezmoi || { log error "Failed to find chezmoi"; return 1; }

  local home_dir="${HOME}"
  local updated=0
  local skipped=0
  local src tmp rel target

  while IFS= read -r target; do
    src="$(chezmoi source-path "$target" 2>/dev/null)" || continue

    [[ "$src" != *.tmpl ]] && continue
    [[ "$src" == *".chezmoi"* || "$src" == *"chezmoiscripts"* ]] && continue
    [[ ! -f "$target" ]] && continue

    # Reverse homeDir substitution on the target. The trap is re-registered per
    # iteration with the path baked in, because a function-scoped EXIT trap runs
    # after locals are popped and a deferred "$tmp" would expand to nothing.
    tmp="$(mktemp)"
    trap "command rm -f ${(q)tmp}" EXIT
    sed "s|${home_dir}|{{ .chezmoi.homeDir }}|g" "$target" > "$tmp"

    if command diff -q "$src" "$tmp" >/dev/null 2>&1; then
      command rm -f "$tmp"
      continue
    fi

    rel="${target#"$home_dir"/}"

    # Look for template syntax beyond .chezmoi.homeDir, which needs a human
    if sed 's/{{[^}]*\.chezmoi\.homeDir[^}]*}}//g' "$src" | grep -q '{{'; then
      log warning "Skipped ${rel} (has secrets/variables, use \`chezmoi merge ${target}\`)"
      (( skipped++ ))
      command rm -f "$tmp"
      continue
    fi

    cp "$tmp" "$src"
    command rm -f "$tmp"
    log success "Synced ${rel}"
    (( updated++ ))
  done < <(chezmoi managed --include=files --path-style=absolute)

  if (( updated + skipped == 0 )); then
    log info "Verified all template-managed files already in sync"
  else
    (( updated > 0 )) && log info "Synced ${updated} file(s) back to source"
    (( skipped > 0 )) && log info "Skipped ${skipped} file(s) with complex templates"
  fi
}

